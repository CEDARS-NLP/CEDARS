def cmd_doctor(args) -> int:
    rows = []

    def row(name, ok, detail, required=True):
        rows.append({"check": name, "ok": bool(ok), "detail": detail, "required": required})

    def ver(cmd):
        try:
            p = subprocess.run(cmd, capture_output=True, text=True, timeout=20)
            return p.returncode == 0, (p.stdout or p.stderr).strip().splitlines()[0] if (p.stdout or p.stderr).strip() else ""
        except (FileNotFoundError, subprocess.TimeoutExpired) as e:
            return False, str(e)

    ok, d = ver(["docker", "info", "--format", "{{.ServerVersion}} {{.Architecture}}"])
    row("docker daemon", ok, d or "start Docker Desktop")
    ok, d = ver(["docker", "compose", "version", "--short"])
    row("docker compose v2", ok, d)
    ok, d = ver(["docker", "buildx", "ls"])
    amd = ok and "linux/amd64" in subprocess.run(["docker", "buildx", "ls"], capture_output=True, text=True).stdout
    row("buildx can build linux/amd64 (Fargate arch)", amd, "QEMU/Rosetta emulation available" if amd else "enable amd64 emulation in Docker Desktop")
    for tool, cmd, req, hint in [("uv", ["uv", "--version"], True, "https://docs.astral.sh/uv/"),
                                 ("git", ["git", "--version"], True, ""),
                                 ("node", ["node", "--version"], False, "needed for `test frontend`"),
                                 ("npm", ["npm", "--version"], False, "needed for `test frontend`"),
                                 ("terraform", ["terraform", "version"], False, "needed for `infra validate`"),
                                 ("aws cli", ["aws", "--version"], False, "needed for `aws status` / `bedrock probe`")]:
        ok, d = ver(cmd)
        row(tool, ok, d if ok else hint, req)
    cache = Path.home() / ("Library/Caches/ms-playwright" if sys.platform == "darwin" else ".cache/ms-playwright")
    has_browser = (cache / f"chromium_headless_shell-{PLAYWRIGHT_CHROMIUM}").exists() or (cache / f"chromium-{PLAYWRIGHT_CHROMIUM}").exists()
    row("playwright chromium", has_browser, str(cache) if has_browser else
        "run: uv run --no-project --with playwright==1.58.0 playwright install chromium", False)
    try:
        st = State(args)
        root = st.root_repo
        dirty = git(root, "status", "--porcelain")
        row("repo", True, f"{root} @ {git(root, 'rev-parse', '--abbrev-ref', 'HEAD')} {git(root, 'rev-parse', '--short=12', 'HEAD')}"
            + (f" ({len(dirty.splitlines())} uncommitted path(s))" if dirty else " (clean)"))
        ps = compose_ps(st) if st.exists else []
        up = any(c.get("State") == "running" for c in ps)
        port = st.data.get("port")
        row("instance", True, f"{st.instance} ({st.project}) "
            + (f"UP at {st.url} since {st.data.get('up_at', '?')}; if you did not start it, another session in this "
               "checkout did: use --instance NAME" if up else "not running")
            + (f", port {port} {'free' if port_free(port) else 'busy'}" if port and not up else ""))
    except CliError as e:
        row("repo", False, str(e))
        st = None
    others = subprocess.run(["docker", "ps", "--format", "{{.Names}}"], capture_output=True, text=True).stdout.split()
    foreign = [n for n in others if not (st and n.startswith(st.project))]
    if foreign:
        row("other containers (not ours: leave alone)", True,
            ", ".join(foreign[:12]) + (f" … and {len(foreign) - 12} more" if len(foreign) > 12 else ""), False)
    failed = [r for r in rows if r["required"] and not r["ok"]]
    if args.json:
        print(json.dumps({"ok": not failed, "checks": rows}, indent=2))
    else:
        for r in rows:
            print(f"  {'OK  ' if r['ok'] else ('FAIL' if r['required'] else 'WARN')}  {r['check']}: {r['detail']}")
        print(f"doctor: {'ready' if not failed else 'NOT ready'}")
    return 1 if failed else 0


