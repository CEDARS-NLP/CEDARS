def tf_variables(infra: Path) -> dict:
    text = (infra / "variables.tf").read_text()
    out = {}
    for m in re.finditer(r'variable\s+"(\w+)"\s*\{(.*?)\n\}', text, re.S):
        d = re.search(r"^\s*default\s*=\s*(.+?)\s*$", m.group(2), re.M)
        if d:
            out[m.group(1)] = d.group(1).strip().strip('"')
    return out


def tf_block(text: str, kind: str, name: str) -> str:
    m = re.search(rf'resource\s+"{kind}"\s+"{name}"\s*\{{(.*?)\n\}}', text, re.S)
    return m.group(1) if m else ""


def compose_config(st: State) -> dict:
    env = st.compose_env() if st.exists else {
        **{k: "placeholder" for k in ("CV_DB_PASSWORD", "CV_SECRET_KEY", "CV_S3_USER", "CV_S3_PASSWORD")},
        "CV_BUCKET": BUCKET,
        "CV_PROJECT": st.project, "CV_PORT": "18000", "CV_BACKEND_IMAGE": "b", "CV_FRONTEND_IMAGE": "f",
        "CV_PLATFORM": "linux/amd64", "CV_STACK_DIR": str(STACK_DIR), "CV_CONTROL_DIR": "/tmp", "CV_EVIDENCE_DIR": "/tmp",
    }
    proc = run(["docker", "compose", "-p", st.project, "-f", str(COMPOSE_FILE), "config", "--format", "json"],
               env=env, capture=True, quiet=True)
    return json.loads(proc.stdout)


def settings_fields(repo: Path) -> dict:
    text = (repo / "backend/app/config.py").read_text()
    fields = {}
    for m in re.finditer(r"^    (\w+): [^=\n]+= (.+)$", text, re.M):
        fields[m.group(1)] = m.group(2).strip()
    return fields


def settings_usage(repo: Path, field: str) -> int:
    count = 0
    for py in (repo / "backend/app").rglob("*.py"):
        if py.name == "config.py" and py.parent.name == "app":
            continue
        count += len(re.findall(rf"settings\.{field}\b", py.read_text(errors="replace")))
    return count


def cmd_parity_check(args) -> int:
    st = State(args)
    repo = st.root_repo
    infra = repo / "infra/cedars-v2"
    ecs = (infra / "ecs.tf").read_text()
    alb = (infra / "alb.tf").read_text()
    main_tf = (infra / "main.tf").read_text()
    var = tf_variables(infra)
    cfg = compose_config(st)
    svc = cfg["services"]
    nginx = (STACK_DIR / "alb.nginx.conf").read_text()
    checks, findings = [], []

    def check(area, name, expected, actual, ok=None, note=""):
        ok = (str(expected) == str(actual)) if ok is None else ok
        checks.append({"area": area, "check": name, "aws": expected, "stack": actual, "ok": bool(ok), "note": note})

    # env: names and literal values from ecs.tf local.app_environment/app_secrets
    tf_env = dict(re.findall(r'\{\s*name\s*=\s*"(CEDARS_\w+)",\s*value\s*=\s*(.+?)\s*\}', ecs))
    tf_secrets = re.findall(r'\{\s*name\s*=\s*"(CEDARS_\w+)",\s*valueFrom', ecs)

    def tf_value(expr: str):
        expr = expr.strip()
        if expr.startswith('"'):
            return expr.strip('"')
        if expr == "var.region":
            return var.get("region")
        if expr == "local.cookie_secure" and 'cookie_secure = var.enable_https ? "true" : "false"' in main_tf:
            return "true" if var.get("enable_https") == "true" else "false"
        if expr == "local.cors_origins" and '"http://localhost:5173"' in main_tf and var.get("app_hostname", "") == "":
            return "http://localhost:5173"
        return None  # resolved by a dedicated check below

    for name in ("backend", "worker", "migrate"):
        env = svc[name].get("environment", {})
        names = {k for k in env if k.startswith("CEDARS_")}
        check("env", f"{name}: CEDARS_* names == ecs.tf app_environment + app_secrets",
              sorted(set(tf_env) | set(tf_secrets)), sorted(names))
    benv = svc["backend"]["environment"]
    for k, expr in tf_env.items():
        expected = tf_value(expr)
        if expected is not None:
            check("env", f"{k} value", repr(expected), repr(benv.get(k)))
    check("env", "CEDARS_REDIS_URL shape", "redis://<host>:6379 (no TLS)", benv.get("CEDARS_REDIS_URL"),
          ok=re.fullmatch(r"redis://[\w.-]+:6379", benv.get("CEDARS_REDIS_URL", "")) is not None)
    check("env", "CEDARS_S3_BUCKET shape", "user-<prefix>-storage", benv.get("CEDARS_S3_BUCKET"),
          ok='bucket = "user-${local.prefix}-storage"' in (infra / "s3.tf").read_text()
          and re.fullmatch(r"user-[\w-]+-storage", benv.get("CEDARS_S3_BUCKET", "")) is not None)
    check("env", "CEDARS_DATABASE_URL shape", "postgresql+asyncpg://cedars:<pw>@<host>:5432/cedars",
          re.sub(r":[^:@/]+@", ":<pw>@", benv.get("CEDARS_DATABASE_URL", "")),
          ok=re.fullmatch(r"postgresql\+asyncpg://cedars:[^@]+@[\w.-]+:5432/cedars", benv.get("CEDARS_DATABASE_URL", "")) is not None)

    # settings wiring
    fields = settings_fields(repo)
    for k in sorted(set(tf_env) | set(tf_secrets)):
        f = k.removeprefix("CEDARS_").lower()
        check("settings", f"{k} maps to a Settings field", f, f if f in fields else "(missing)")
    for f, default in fields.items():
        if f == "model_config":
            continue
        uses = settings_usage(repo, f)
        if uses == 0:
            findings.append({"severity": "should-fix", "finding": f"Settings.{f} is declared but never read"
                             + (f" (ecs.tf sets CEDARS_{f.upper()}, which does nothing)" if f"CEDARS_{f.upper()}" in tf_env else "")})
    for f, risky in (("s3_endpoint", "MinIO URL"), ("s3_access_key", "MinIO key"), ("secret_key", "placeholder")):
        if f in fields and fields[f] not in ('""', "''"):
            findings.append({"severity": "nit", "finding": f"Settings.{f} defaults to a {risky} ({fields[f]}); if the env var is ever dropped the app starts anyway instead of failing"})

    # resources + counts (variables.tf defaults; migrate literals in ecs.tf)
    def limits(name):
        lim = svc[name].get("deploy", {}).get("resources", {}).get("limits", {})
        return float(lim.get("cpus", 0)), int(lim.get("memory", 0)) // (1024 * 1024)
    for name in ("backend", "worker", "frontend"):
        cpus, mem = limits(name)
        check("resources", f"{name} cpu units", var.get(f"{name}_cpu"), int(cpus * 1024))
        check("resources", f"{name} memory MiB", var.get(f"{name}_memory"), mem)
        check("resources", f"{name} desired count", var.get(f"{name}_desired_count"), svc[name].get("deploy", {}).get("replicas", 1))
    mig = tf_block(ecs, "aws_ecs_task_definition", "migrate")
    mcpu = re.search(r"cpu\s*=\s*(\d+)", mig)
    mmem = re.search(r"memory\s*=\s*(\d+)", mig)
    cpus, mem = limits("migrate")
    check("resources", "migrate cpu units", mcpu.group(1) if mcpu else "?", int(cpus * 1024))
    check("resources", "migrate memory MiB", mmem.group(1) if mmem else "?", mem)

    # commands
    def tf_command(block):
        m = re.search(r"command\s*=\s*(\[[^\]]*\])", block)
        return json.loads(m.group(1)) if m else None
    check("commands", "worker command", tf_command(tf_block(ecs, "aws_ecs_task_definition", "worker")), svc["worker"].get("command"))
    check("commands", "migrate command", tf_command(mig), svc["migrate"].get("command"))
    check("commands", "backend uses image CMD (no override)", None, svc["backend"].get("command"))
    check("commands", "frontend uses image CMD (no override)", None, svc["frontend"].get("command"))
    check("platform", "task runtime platform", "X86_64 (no runtime_platform in ecs.tf)" if "runtime_platform" not in ecs else "set in ecs.tf",
          svc["backend"].get("platform"), ok=("runtime_platform" in ecs) or svc["backend"].get("platform") == "linux/amd64",
          note="native builds are allowed with --platform native but must be reported")

    # ALB
    idle = re.search(r"idle_timeout\s*=\s*(\d+)", alb)
    check("alb", "idle_timeout -> proxy_read_timeout", idle.group(1) if idle else "?",
          (re.search(r"proxy_read_timeout (\d+)s", nginx) or [None, "?"])[1])
    patterns = re.findall(r'values\s*=\s*\[([^\]]*)\]', tf_block(alb, "aws_lb_listener_rule", "backend"))
    tf_paths = sorted(p.strip().strip('"') for p in ",".join(patterns).split(",") if p.strip())
    ng_paths = sorted(f"{loc}*" for loc in re.findall(r"location (/\w+/) ", nginx))
    check("alb", "backend path patterns", tf_paths, ng_paths)
    hc = re.findall(r'path\s*=\s*"([^"]+)"', alb)
    check("alb", "backend health path served by app", hc[0] if hc else "?",
          "/api/v1/health" if '"/api/v1/health"' in (repo / "backend/app/main.py").read_text() else "(missing)")
    dur = re.search(r"cookie_duration\s*=\s*(\d+)", alb)
    check("alb", "backend stickiness lb_cookie duration", dur.group(1) if dur else "none",
          (re.search(r"Max-Age=(\d+)", nginx) or [None, "none"])[1])
    check("alb", "frontend target group stickiness", "none" if alb.count("stickiness") == 1 else "set",
          "none" if "hash" not in nginx.split("upstream frontend_tg")[1].split("}")[0] else "set")

    # managed-service versions
    pg_image = svc["postgres"]["image"]
    check("versions", "Aurora PostgreSQL engine", var.get("db_engine_version"), pg_image.split(":")[1].split("-")[0])
    redis_image = svc["redis"]["image"]
    check("versions", "ElastiCache Redis engine", var.get("redis_engine_version"), redis_image.split(":")[1].split("-")[0],
          ok=True, note="known gap: no OSS 7.1 image; 7.0.15 is the protocol-compatible stand-in")

    # images: Dockerfiles are shared with the deploy by construction; flag unpinned bases
    for part in ("backend", "frontend"):
        df = (repo / part / "Dockerfile").read_text()
        stages = set(re.findall(r"^FROM\s+\S+\s+AS\s+(\S+)", df, re.M | re.I))
        for img in re.findall(r"(?:FROM|--from=)\s*(\S+)", df):
            if img in stages:
                continue
            if img.endswith(":latest") or ":" not in img.split("/")[-1] or re.search(r":(alpine|slim)$", img):
                findings.append({"severity": "nit", "finding": f"{part}/Dockerfile uses floating base {img}; the deploy and this stack can differ build to build"})
    if "uv run" in json.dumps(svc["worker"].get("command")) or "uv\", \"run" in (repo / "backend/Dockerfile").read_text():
        findings.append({"severity": "nit", "finding": "containers start through `uv run`, which re-checks the environment at startup; `.venv/bin/...` would be deterministic"})

    failed = [c for c in checks if not c["ok"]]
    if args.json:
        print(json.dumps({"ok": not failed, "checks": checks, "findings": findings}, indent=2))
    else:
        for c in checks:
            print(f"  {'PASS' if c['ok'] else 'FAIL'}  [{c['area']}] {c['check']}: aws={c['aws']} stack={c['stack']}"
                  + (f"  ({c['note']})" if c["note"] else ""))
        for f in findings:
            print(f"  NOTE  [{f['severity']}] {f['finding']}")
        print(f"parity check: {len(checks) - len(failed)}/{len(checks)} match" + ("" if not failed else f", {len(failed)} DRIFT"))
    return 1 if failed else 0


def cmd_infra_validate(args) -> int:
    st = State(args)
    st.init()
    infra = st.root_repo / "infra/cedars-v2"
    scratch = st.dir / "tf-validate"
    if scratch.exists():
        shutil.rmtree(scratch)
    shutil.copytree(infra, scratch, ignore=shutil.ignore_patterns(".terraform", "*.tfstate*", ".terraform.lock.hcl.bak"))
    results = []
    for label, cmd, cwd in [
        ("fmt -check", ["terraform", "fmt", "-check", "-recursive", "-diff", "-no-color"], infra),
        ("init -backend=false", ["terraform", "init", "-backend=false", "-input=false", "-no-color"], scratch),
        ("validate", ["terraform", "validate", "-no-color"], scratch),
    ]:
        proc = run(cmd, cwd=cwd, check=False, capture=True, timeout=600)
        out = (proc.stdout + proc.stderr).strip()
        results.append({"step": label, "ok": proc.returncode == 0, "detail": out.splitlines()[-1] if out else ""})
        if proc.returncode != 0:
            log(out[-3000:])
            break
    ok = all(r["ok"] for r in results) and len(results) == 3
    emit(args, {"ok": ok, "steps": results},
         "\n".join(f"  {'PASS' if r['ok'] else 'FAIL'}  terraform {r['step']}: {r['detail']}" for r in results)
         + f"\ninfra validate: {'PASS' if ok else 'FAIL'} (no plan/apply; never touches the TFC workspace)")
    return 0 if ok else 1


# --------------------------------------------------------------------------- HTTP client


def user_email(role: str) -> str:
    return f"verify-{role}@example.com"  # EmailStr rejects .local/.test


def jar_for(st: State, role: str) -> http.cookiejar.MozillaCookieJar:
    jar = http.cookiejar.MozillaCookieJar(str(st.cookies / f"{role}.txt"))
    if Path(jar.filename).exists():
        jar.load(ignore_discard=True, ignore_expires=True)
    return jar


def client_for(st: State, role: str | None):
    import httpx

    jar = jar_for(st, role) if role else http.cookiejar.CookieJar()
    return httpx.Client(base_url=st.url, cookies=jar, timeout=60.0), jar


def save_jar(jar) -> None:
    """Write the jar atomically so parallel callers never read a half-written file."""
    if isinstance(jar, http.cookiejar.MozillaCookieJar):
        tmp = f"{jar.filename}.{os.getpid()}.tmp"
        jar.save(tmp, ignore_discard=True, ignore_expires=True)
        os.replace(tmp, jar.filename)


def login(st: State, role: str) -> dict:
    """Register (idempotent) and log in a synthetic user; cookies land in the role's jar."""
    client, jar = client_for(st, role)
    pw = st.data["secrets"]["user_password"]
    with client:
        r = client.post("/api/v1/auth/register", json={"email": user_email(role), "name": f"Verify {role.title()}", "password": pw})
        if r.status_code not in (201, 400):
            raise CheckFailed(f"register {role} -> {r.status_code} {r.text[:300]}")
        r = client.post("/api/v1/auth/login", json={"email": user_email(role), "password": pw})
        if r.status_code != 200:
            raise CheckFailed(f"login {role} -> {r.status_code} {r.text[:300]}")
        save_jar(jar)
        return r.json()["user"]


def expand_path(st: State, path: str) -> str:
    seed = st.data.get("last_seed") or {}
    for key, val in (("{project}", seed.get("project_id")), ("{source}", seed.get("data_source_id"))):
        if key in path:
            if not val:
                raise CliError(f"{key} needs a seeded project; run `control-cedars seed` first")
            path = path.replace(key, val)
    if not path.startswith("/"):
        raise CliError("path must start with / (e.g. /projects or /api/v1/health)")
    return path if path.startswith(("/api/", "/ws/")) or path == "/" else "/api/v1" + path


def api_call(st: State, role: str | None, method: str, path: str, *, json_body=None, data=None, files=None, retry_auth=True,
             quiet=False):
    client, jar = client_for(st, role)
    url = expand_path(st, path)
    with client:
        t0 = time.time()
        r = client.request(method.upper(), url, json=json_body, data=data, files=files)
        if r.status_code == 401 and role and retry_auth and "/auth/" not in url:
            save_jar(jar)
            login(st, role)
            return api_call(st, role, method, path, json_body=json_body, data=data, files=files, retry_auth=False,
                            quiet=quiet)
        save_jar(jar)
        if not quiet:
            log(f"HTTP {r.status_code} {method.upper()} {url} as {role or 'anon'} ({(time.time() - t0) * 1000:.0f} ms)")
        return r


def json_path(obj, path: str) -> list:
    """Values at a dot path (`metrics.llm_status`, `results.0.id`); `[*]` fans out over a list."""
    vals = [obj]
    for part in re.findall(r"\[\*\]|[^.\[\]]+", path):
        nxt = []
        for v in vals:
            if part == "[*]":
                nxt.extend(v if isinstance(v, list) else [])
            elif isinstance(v, list) and part.isdigit() and int(part) < len(v):
                nxt.append(v[int(part)])
            elif isinstance(v, dict) and part in v:
                nxt.append(v[part])
        vals = nxt
    return vals


def as_text(v) -> str:
    return v if isinstance(v, str) else json.dumps(v)


def until_holds(body, expr: str) -> bool:
    """`PATH=VALUE` / `PATH!=VALUE`; every value at PATH must compare, and there must be at least one."""
    m = re.fullmatch(r"(.+?)(!=|=)(.*)", expr)
    if not m:
        raise CliError(f"--until {expr!r}: use PATH=VALUE or PATH!=VALUE (e.g. metrics.llm_status=completed)")
    path, op, want = m.groups()
    vals = json_path(body, path)
    return bool(vals) and all((as_text(v) == want) == (op == "=") for v in vals)


def cmd_api(args) -> int:
    st = State(args)
    st.require_stack()
    body, data, files = None, None, None
    if args.json_body is not None:
        raw = sys.stdin.read() if args.json_body == "-" else (Path(args.json_body[1:]).read_text() if args.json_body.startswith("@") else args.json_body)
        body = json.loads(raw)
    if args.form:
        data = dict(kv.split("=", 1) for kv in args.form)
    if args.file:
        files = {}
        for spec in args.file:
            field, p = spec.split("=", 1)
            path = Path(p).expanduser()
            files[field] = (path.name, path.read_bytes())
    role = None if args.as_user == "anon" else args.as_user
    if role and not (st.cookies / f"{role}.txt").exists():
        login(st, role)
    if args.until and args.method.upper() != "GET":
        raise CliError("--until re-sends the request until it holds; use it with GET only")
    for e in args.until or []:
        until_holds({}, e)  # syntax check before the first request
    r = api_call(st, role, args.method, args.path, json_body=body, data=data, files=files)
    ctype = r.headers.get("content-type", "")
    parsed = r.json() if "json" in ctype and r.content else r.text
    timed_out, started, polls = False, time.time(), 1
    while args.until:
        pending = [e for e in args.until if not until_holds(parsed, e)]
        if not pending:
            log(f"= until {' and '.join(args.until)}: held after {time.time() - started:.0f}s ({polls} request(s))")
            break
        if time.time() - started >= args.timeout:
            timed_out = True
            log(f"FAIL: still not {' and '.join(pending)} after {args.timeout}s ({polls} request(s)); last response below")
            break
        if polls % 10 == 0:
            log(f"  waiting for {' and '.join(pending)} ({time.time() - started:.0f}s)")
        time.sleep(args.interval)
        r = api_call(st, role, args.method, args.path, quiet=True)
        ctype = r.headers.get("content-type", "")
        parsed = r.json() if "json" in ctype and r.content else r.text
        polls += 1
    if args.field:
        vals = json_path(parsed, args.field)
        if not vals:
            log(f"no value at {args.field!r} in HTTP {r.status_code} response: {as_text(parsed)[:300]}")
            return 1
        print("\n".join(as_text(v) for v in vals))
    else:
        print(json.dumps(parsed, indent=2) if not isinstance(parsed, str) else parsed)
    if args.save:
        (st.evidence / f"{args.save}.json").write_text(json.dumps(
            {"request": {"method": args.method.upper(), "path": expand_path(st, args.path), "as": args.as_user},
             "status": r.status_code, "body": parsed}, indent=2))
        log(f"saved {st.evidence / (args.save + '.json')}")
    if timed_out:
        return 1
    if args.expect:
        return 0 if r.status_code == args.expect else 1
    return 0 if r.is_success else 1


def cmd_ws(args) -> int:
    """Open a WebSocket through the ALB the way a browser would (only cookies whose path matches /ws)."""
    from urllib.request import Request

    from websockets.sync.client import connect

    st = State(args)
    st.require_stack()
    path = expand_path(st, args.path)
    url = st.url.replace("http://", "ws://") + path
    headers = {}
    if args.as_user != "anon":
        if not (st.cookies / f"{args.as_user}.txt").exists():
            login(st, args.as_user)
        jar = jar_for(st, args.as_user)
        req = Request(st.url + path)
        jar.add_cookie_header(req)
        if req.get_header("Cookie"):
            headers["Cookie"] = req.get_header("Cookie")
    log(f"+ websocket {url} as {args.as_user} (cookies sent: {'yes' if headers else 'none'})")
    messages, closed = [], None
    deadline = time.time() + args.seconds
    try:
        with connect(url, additional_headers=headers, open_timeout=10) as ws:
            while time.time() < deadline and len(messages) < args.max_messages:
                try:
                    msg = ws.recv(timeout=max(0.1, deadline - time.time()))
                except TimeoutError:
                    break
                print(msg, flush=True)
                messages.append(msg)
    except Exception as e:  # noqa: BLE001 - report any handshake/close reason
        closed = f"{type(e).__name__}: {e}"
        log(f"websocket closed: {closed}")
    log(f"received {len(messages)} message(s)")
    if args.save:  # saved on failure too: a socket that closes silently is the evidence
        out = st.evidence / f"{args.save}.json"
        out.write_text(json.dumps({"url": path, "as": args.as_user, "cookies_sent": bool(headers),
                                   "closed": closed, "messages": messages}, indent=2))
        log(f"saved {out}")
    return 0 if messages else 1


