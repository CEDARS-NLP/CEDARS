           "SID=$(control-cedars api POST /projects/{project}/evaluation/sessions --body '{\"search_queries\":[]}' --field id)\n"
           "control-cedars api GET /projects/{project}/evaluation/sessions/$SID --until metrics.llm_status=completed\n"
           "control-cedars api GET \"/projects/{project}/evaluation/sessions/$SID/results?page_size=100\" --field 'results[*].status'\n"
           "control-cedars api DELETE /projects/{project} --as viewer --expect 403\n"
           "control-cedars api POST /projects/{project}/data/upload --file file=notes.csv --form 'column_mapping={...}'",
    "ws": "control-cedars ws /ws/projects/{project}/jobs/<job_id> --seconds 5 --as admin",
    "browser snapshot": "control-cedars browser snapshot /projects/{project}/data --as admin --wait-text 'Data sources'",
    "browser screenshot": "control-cedars browser screenshot /projects --as viewer --save viewer-projects",
    "browser run": "control-cedars browser run steps.json --as admin --save ingest-ui\n"
                   "echo '[{\"goto\":\"/projects/{project}/data\"},{\"expect_text\":\"Ingested\"},{\"screenshot\":\"done\"}]' | control-cedars browser run - --as admin\n"
                   "steps: goto | click | fill(+value) | select(+value) | press(+on) | check | upload(+file) | expect_text |\n"
                   "       expect_no_text | expect(+state) | expect_url | wait | screenshot | snapshot; optional timeout (s)\n"
                   "locator: Playwright selector string, or {role,name,exact} {text} {label} {placeholder} {css} {testid} + nth/within",
    "llm mode": "control-cedars llm mode            # show\ncontrol-cedars llm mode empty      # replies '{}' (the Bedrock regression fixed in cef61132)\ncontrol-cedars llm mode normal",
    "llm calls": "control-cedars llm calls\ncontrol-cedars llm calls --json --tail 5",
    "aws status": "control-cedars aws status                  # read-only: ECS services, deployed image SHA, target health, undeployed commits\n"
                  "control-cedars aws status --profile saml --json",
    "bedrock probe": "control-cedars bedrock probe --yes-cost    # ONLY after the user agrees: 2 paid Haiku calls in the amd64 image",
    "deploy rehearse": "control-cedars deploy rehearse --from c7cf4c74      # old release + data, migrate with new image, old must survive, roll\n"
                       "control-cedars deploy rehearse --from aws           # read the deployed SHA first (read-only AWS)",
    "evidence": "control-cedars evidence dir\ncontrol-cedars evidence list",
    "cleanup": "control-cedars cleanup            # stack, CI postgres, ref worktrees, cookies; evidence kept\ncontrol-cedars cleanup --images",
}


def build_parser() -> argparse.ArgumentParser:
    def global_flags(suppress: bool) -> argparse.ArgumentParser:
        # Accepted before or after the subcommand. Subparser copies default to SUPPRESS so they
        # never overwrite a value given before the subcommand (argparse applies sub defaults last).
        d = {"default": argparse.SUPPRESS} if suppress else {}
        g = argparse.ArgumentParser(add_help=False)
        g.add_argument("--instance", help="stack instance name (default: repo folder name; env CEDARS_VERIFY_INSTANCE)", **d)
        g.add_argument("--repo", help="CEDARS checkout to verify (default: git toplevel of cwd)", **d)
        g.add_argument("--json", action="store_true", help="machine-readable output on stdout", **d)
        return g

    common = global_flags(suppress=True)
    p = argparse.ArgumentParser(prog="control-cedars", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter,
                                parents=[global_flags(suppress=False)])
    sub = p.add_subparsers(dest="cmd", required=True, metavar="<command>")

    def add(parent_sub, name, fn, help_text, key=None):
        sp = parent_sub.add_parser(name.split()[-1], help=help_text, description=help_text, parents=[common],
                                   epilog="examples:\n  " + EXAMPLES.get(key or name, "").replace("\n", "\n  "),
                                   formatter_class=argparse.RawDescriptionHelpFormatter)
        sp.set_defaults(fn=fn)
        return sp

    add(sub, "doctor", cmd_doctor, "check tools, emulation, ports, repo and instance state")

    stack = sub.add_parser("stack", help="launch / inspect / stop the AWS-parity stack").add_subparsers(dest="stack_cmd", required=True, metavar="<verb>")
    sp = add(stack, "stack up", cmd_stack_up, "build images like the deploy runbook, start the stack, wait for ALB-style health")
    sp.add_argument("--ref", help="git ref to build instead of the working tree (built in a detached worktree)")
    sp.add_argument("--platform", choices=("amd64", "native"), default="amd64", help="image arch (default amd64 = Fargate)")
    sp.add_argument("--no-build", action="store_true", help="reuse recorded images")
    sp.add_argument("--rebuild", action="store_true", help="rebuild ref images even if present")
    sp.add_argument("--port", type=int, help="host port for the ALB (default derived from instance)")
    sp.add_argument("--no-egress", action="store_true", help="no internet from app containers")
    sp.add_argument("--timeout", type=int, default=900, help="seconds to wait for health (default 900)")
    add(stack, "stack status", cmd_stack_status, "services, replicas, health, ALB and worker heartbeat")
    sp = add(stack, "stack logs", cmd_stack_logs, "service logs (alb backend worker frontend migrate postgres redis s3 fake-llm)")
    sp.add_argument("service", nargs="*", help="services (default all)")
    sp.add_argument("--tail", type=int, default=200)
    sp.add_argument("--since", help="e.g. 10m, 2026-10-04T12:00:00")
    sp.add_argument("--grep", help="regex filter; exit 1 when nothing matches")
    sp = add(stack, "stack restart", cmd_stack_restart, "restart services (e.g. worker for orphan recovery)")
    sp.add_argument("service", nargs="+")
    sp.add_argument("--timeout", type=int, default=300)
    sp = add(stack, "stack down", cmd_stack_down, "stop the stack (volumes removed unless --keep-volumes); evidence kept")
    sp.add_argument("--keep-volumes", action="store_true")

    db = sub.add_parser("db", help="read-only database access").add_subparsers(dest="db_cmd", required=True, metavar="<verb>")
    sp = add(db, "db query", cmd_db_query, "run read-only SQL (default_transaction_read_only=on); {project} and {source} expand to the last seed")
    sp.add_argument("sql", help="SQL text, or - for stdin")
    sp.add_argument("--csv", action="store_true")

    mig = sub.add_parser("migrate", help="Alembic checks").add_subparsers(dest="migrate_cmd", required=True, metavar="<verb>")
    add(mig, "migrate status", cmd_migrate_status, "alembic current vs heads on the stack DB")
    add(mig, "migrate check", cmd_migrate_check, "migration round-trip + model drift on a scratch DB")

    test = sub.add_parser("test", help="CI-parity test suites").add_subparsers(dest="test_cmd", required=True, metavar="<suite>")
    for name, fn, h in (("test backend", cmd_test_backend, "backend-v2.yml jobs (SQLite default, --postgres for the Postgres job)"),
                        ("test frontend", cmd_test_frontend, "tsc, eslint, vite build (no frontend CI exists)"),
                        ("test all", cmd_test_all, "backend sqlite + backend postgres + frontend")):
        sp = add(test, name, fn, h)
        sp.add_argument("--ref", help="test a git ref in a detached worktree instead of the working tree")
        if name == "test backend":
            sp.add_argument("--postgres", action="store_true")
        if name in ("test frontend",):
            sp.add_argument("--ci", action="store_true", help="run npm ci first")
        if name != "test frontend":
            sp.add_argument("pytest_args", nargs=argparse.REMAINDER, help="after --: extra pytest args")

    ci = sub.add_parser("ci", help="real GitHub Actions results (read-only gh)").add_subparsers(dest="ci_cmd", required=True, metavar="<verb>")
    sp = add(ci, "ci status", cmd_ci_status, "latest workflow runs on a branch: job and step failures, failed tests; exit 0 only if the latest completed run passed")
    sp.add_argument("--workflow", default="backend-v2.yml")
    sp.add_argument("--branch", help="default: current branch")
    sp.add_argument("--limit", type=int, default=5)

    par = sub.add_parser("parity", help="static stack <-> Terraform <-> Settings comparison").add_subparsers(dest="parity_cmd", required=True, metavar="<verb>")
    add(par, "parity check", cmd_parity_check, "diff env, resources, commands, ALB rules, versions; list wiring findings")

    infra = sub.add_parser("infra", help="Terraform checks (never plan/apply)").add_subparsers(dest="infra_cmd", required=True, metavar="<verb>")
    add(infra, "infra validate", cmd_infra_validate, "terraform fmt -check, init -backend=false, validate")

    sp = add(sub, "seed", cmd_seed, "synthetic users (admin/annotator/viewer), project on the fake LLM, sample data, ingestion")
    sp.add_argument("--project-name")
    sp.add_argument("--no-upload", action="store_true")
    sp.add_argument("--no-ingest", action="store_true")
    sp.add_argument("--timeout", type=int, default=300)

    sp = add(sub, "api", cmd_api, "HTTP request through the ALB as a seeded user ({project}/{source} expand)")
    sp.add_argument("method")
    sp.add_argument("path", help="/projects/... (prefixed with /api/v1) or a full /api/... path")
    sp.add_argument("--as", dest="as_user", choices=(*ROLES, "anon"), default="admin")
    sp.add_argument("--body", dest="json_body", metavar="JSON", help="JSON request body, @file, or - for stdin")
    sp.add_argument("--form", action="append", metavar="K=V")
    sp.add_argument("--file", action="append", metavar="FIELD=PATH")
    sp.add_argument("--expect", type=int, help="exit 0 only if the status matches (e.g. 403)")
    sp.add_argument("--save", metavar="NAME", help="write request+response to evidence/NAME.json")
    sp.add_argument("--field", metavar="PATH", help="print only this value (dot path, [*] for every list item), e.g. id")
    sp.add_argument("--until", action="append", metavar="PATH=VALUE",
                    help="GET only: repeat every --interval s until it holds (also PATH!=VALUE; repeat to AND); "
                         "exit 1 on --timeout")
    sp.add_argument("--interval", type=float, default=3)
    sp.add_argument("--timeout", type=int, default=300)

    sp = add(sub, "ws", cmd_ws, "open a WebSocket through the ALB like a browser and print messages")
    sp.add_argument("path")
    sp.add_argument("--as", dest="as_user", choices=(*ROLES, "anon"), default="admin")
    sp.add_argument("--seconds", type=float, default=5)
    sp.add_argument("--max-messages", type=int, default=50)
    sp.add_argument("--save", metavar="NAME", help="write the messages to evidence/NAME.json")

    br = sub.add_parser("browser", help="headless Chromium against the ALB (Playwright)").add_subparsers(dest="browser_cmd", required=True, metavar="<verb>")
    for name, h in (("browser snapshot", "print the ARIA snapshot (roles/names to drive) + screenshot"),
                    ("browser screenshot", "screenshot a page into evidence"),
                    ("browser run", "run a JSON list of steps; failure saves screenshot + ARIA snapshot")):
        sp = add(br, name, cmd_browser, h)
        sp.add_argument("--as", dest="as_user", choices=(*ROLES, "anon"), default="admin")
        sp.add_argument("--save", metavar="NAME", help="evidence file prefix")
        sp.add_argument("--timeout", type=float, default=20, help="seconds per step / page load (default 20)")
        sp.add_argument("--strict", action="store_true", help="exit 1 on any API 4xx/5xx or console error")
        if name == "browser run":
            sp.add_argument("steps", nargs="?", help="steps JSON file or - (stdin)")
            sp.add_argument("--headed", action="store_true")
            sp.add_argument("--slow-mo", type=int, default=0)
        else:
            sp.add_argument("path")
            sp.add_argument("--wait-text")
            sp.add_argument("--full-page", action="store_true")

    llm = sub.add_parser("llm", help="fake LLM controls").add_subparsers(dest="llm_cmd", required=True, metavar="<verb>")
    sp = add(llm, "llm mode", cmd_llm_mode, "show or set the fake LLM failure mode (live, no restart)")
    sp.add_argument("mode", nargs="?", choices=LLM_MODES)
    sp = add(llm, "llm calls", cmd_llm_calls, "count fake LLM calls (proxy for Bedrock spend)")
    sp.add_argument("--tail", type=int, default=3)
    sp.add_argument("--since", help="ISO timestamp")

    def aws_args(sp):
        sp.add_argument("--profile", default="saml", help="AWS profile (default: %(default)s)")
        sp.add_argument("--region", default="us-east-1", help="default: %(default)s")
        sp.add_argument("--cluster", default=AWS_PREFIX, help="ECS cluster (default: %(default)s)")

    awsp = sub.add_parser("aws", help="read-only AWS inspection").add_subparsers(dest="aws_cmd", required=True, metavar="<verb>")
    aws_args(add(awsp, "aws status", cmd_aws_status, "what DEV runs vs local git (describe/list calls only)"))

    bed = sub.add_parser("bedrock", help="real Bedrock check (costs money)").add_subparsers(dest="bedrock_cmd", required=True, metavar="<verb>")
    sp = add(bed, "bedrock probe", cmd_bedrock_probe, "classify one positive + one negative synthetic excerpt via Bedrock")
    aws_args(sp)
    sp.add_argument("--model", default=DEFAULT_BEDROCK_MODEL, help="Bedrock model the 2 paid calls use (default: %(default)s)")
    sp.add_argument("--image", help="backend image (default: stack image)")
    sp.add_argument("--yes-cost", action="store_true", help="confirm the user approved the paid calls")

    dep = sub.add_parser("deploy", help="local replay of the ECS deploy runbook").add_subparsers(dest="deploy_cmd", required=True, metavar="<verb>")
    sp = add(dep, "deploy rehearse", cmd_deploy_rehearse, "old release + data -> migrate with new image -> old survives -> roll")
    sp.add_argument("--from", dest="from_ref", required=True, help="git ref of the current release, or 'aws'")
    sp.add_argument("--to", dest="to_ref", help="git ref of the new release (default: working tree)")
    sp.add_argument("--platform", choices=("amd64", "native"), default="amd64")
    sp.add_argument("--port", type=int)
    sp.add_argument("--timeout", type=int, default=900)
    aws_args(sp)

    ev = sub.add_parser("evidence", help="evidence directory (survives cleanup)").add_subparsers(dest="evidence_cmd", required=True, metavar="<verb>")
    add(ev, "evidence dir", cmd_evidence, "print the evidence directory", key="evidence")
    add(ev, "evidence list", cmd_evidence, "list evidence files", key="evidence")

    sp = add(sub, "cleanup", cmd_cleanup, "remove everything this instance started; keep evidence")
    sp.add_argument("--images", action="store_true", help="also remove images this instance built")
    sp.add_argument("--keep-state", action="store_true", help="keep this instance's recorded images and seed in state.json (default: forget them, so the last instance cleaned with --images can remove shared images)")
    return p


def main(argv=None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    if getattr(args, "pytest_args", None) and args.pytest_args[:1] == ["--"]:
        args.pytest_args = args.pytest_args[1:]
    try:
        return args.fn(args)
    except CliError as e:
        log(f"error: {e}")
        return 2
    except CheckFailed as e:
        log(f"FAIL: {e}")
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
