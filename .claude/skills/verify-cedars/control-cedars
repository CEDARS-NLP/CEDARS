def cmd_cleanup(args) -> int:
    st = State(args)
    removed = []
    if st.exists:
        st.compose("down", "-v", "--remove-orphans", check=False, capture=True)
        removed.append(f"compose project {st.project} (containers, networks, volumes)")
    for c in (f"{st.project}-ci-pg",):
        if run(["docker", "rm", "-f", c], check=False, capture=True, quiet=True).returncode == 0:
            removed.append(f"container {c}")
    if st.src.exists():
        for wt in st.src.iterdir():
            run(["git", "-C", str(st.root_repo), "worktree", "remove", "--force", str(wt)], check=False, capture=True)
            removed.append(f"worktree {wt}")
        run(["git", "-C", str(st.root_repo), "worktree", "prune"], check=False, capture=True, quiet=True)
    if st.cookies.exists():
        shutil.rmtree(st.cookies)
        removed.append("cookie jars")
    kept_images = []
    if args.images:
        # `docker image rm` only refuses an image's last tag, so check what other instances still record first.
        elsewhere = set()
        for f in STATE_ROOT.glob("*/state.json"):
            if f.parent.name != st.instance:
                with contextlib.suppress(ValueError, OSError):
                    elsewhere |= set((json.loads(f.read_text()).get("images") or {}).get(k) for k in ("backend", "frontend"))
        for img in st.data.get("built_images", []):
            if img in elsewhere:
                kept_images.append(img)  # keep it recorded so a later cleanup removes it
            elif run(["docker", "image", "rm", img], check=False, capture=True, quiet=True).returncode == 0:
                removed.append(f"image {img}")
            elif run(["docker", "image", "inspect", img], check=False, capture=True, quiet=True).returncode == 0:
                kept_images.append(img)  # a container outside any instance state still uses it
        st.data["built_images"] = kept_images
        # Untagged leftovers of rebuilt tags; prune skips any image a container still uses.
        pruned = run(["docker", "image", "prune", "-f", "--filter", "label=cedars-verify=1"],
                     check=False, capture=True, quiet=True).stdout
        n = sum(1 for ln in pruned.splitlines() if ln.startswith("deleted:"))
        if n:
            removed.append(f"{n} untagged cedars-verify image layer(s)")
    leftovers = subprocess.run(["docker", "ps", "-a", "-q", "--filter", f"label=com.docker.compose.project={st.project}"],
                               capture_output=True, text=True).stdout.split()
    vols = subprocess.run(["docker", "volume", "ls", "-q", "--filter", f"label=com.docker.compose.project={st.project}"],
                          capture_output=True, text=True).stdout.split()
    if st.exists:
        st.data.pop("images", None) if not args.keep_state else None
        st.data.pop("last_seed", None) if not args.keep_state else None
        st.save()
    evidence = sorted(p.name for p in st.evidence.iterdir()) if st.evidence.exists() else []
    ok = not leftovers and not vols
    emit(args, {"ok": ok, "removed": removed, "leftover_containers": leftovers, "leftover_volumes": vols,
                "images_in_use": kept_images, "evidence_dir": str(st.evidence), "evidence_files": len(evidence)},
         "\n".join(f"  removed {r}" for r in removed)
         + "".join(f"\n  kept image {i} (another instance still uses it; re-run cleanup --images after that one)" for i in kept_images)
         + f"\n  leftovers: containers={len(leftovers)} volumes={len(vols)}"
         + f"\n  evidence kept: {st.evidence} ({len(evidence)} files)\ncleanup: {'clean' if ok else 'LEFTOVERS'}")
    return 0 if ok else 1


