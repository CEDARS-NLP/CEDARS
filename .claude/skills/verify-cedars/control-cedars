def cmd_deploy_rehearse(args) -> int:
    """Replay the deploy runbook locally: old images serving + data, migrate with new image, old must survive, then roll."""
    st = State(args)
    st.init()
    from_ref = args.from_ref
    if from_ref == "aws":
        from_ref = deployed_shas(args)["backend"].get("sha")
        if not from_ref:
            raise CliError("could not read the deployed backend SHA tag from ECR; pass --from <ref>")
        log(f"= deployed backend is {from_ref}")
    if any(c.get("State") == "running" for c in compose_ps(st)):
        raise CliError(f"instance '{st.instance}' already has a running stack and rehearsal needs a fresh DB. "
                       f"Use another instance (CEDARS_VERIFY_INSTANCE={st.instance}-2). Run `stack down` only if "
                       "you started that stack yourself")
    report = {"from": from_ref, "to": args.to_ref or "worktree", "steps": []}
    try:
        return _rehearse(args, st, from_ref, report)
    except Exception as e:
        if not report["steps"] or report["steps"][-1]["ok"]:  # failed inside a step's action, not its check
            report["steps"].append({"step": "(next step)", "ok": False, "detail": f"{type(e).__name__}: {e}"})
        report["ok"] = False
        out = st.evidence / f"deploy-rehearsal-{stamp()}.json"
        out.write_text(json.dumps(report, indent=2))
        log(f"saved {out}")
        raise


def _rehearse(args, st: "State", from_ref: str, report: dict) -> int:
    def step(name, ok, detail=""):
        report["steps"].append({"step": name, "ok": ok, "detail": detail})
        log(f"  {'PASS' if ok else 'FAIL'}  {name} {detail}")
        if not ok:
            raise CheckFailed(f"deploy rehearsal failed at: {name} {detail}")

    up = argparse.Namespace(**{**vars(args), "ref": from_ref, "no_build": False, "rebuild": False, "port": args.port,
                               "no_egress": False, "timeout": args.timeout, "json": True})
    try:
        cmd_stack_up(up)
    except CheckFailed as e:
        step("old release up", False, f"{from_ref}: {e}")
    step("old release up", True, f"{from_ref}")
    # The old release may have its own bugs; the API check is the baseline below, not part of seeding.
    seed_ns = argparse.Namespace(**{**vars(args), "project_name": "rehearsal", "no_upload": False, "no_ingest": False,
                                    "json": True, "tolerate_api_errors": True})
    cmd_seed(seed_ns)
    st = State(args)
    pid = st.data["last_seed"]["project_id"]
    step("seed data on old release", True, f"{pid} patients={st.data['last_seed']['patients']}")
    paths = ("/projects", f"/projects/{pid}", f"/projects/{pid}/data/patients?limit=5",
             f"/projects/{pid}/data/sources", f"/projects/{pid}/evaluation/sessions")
    report["baseline_old_release"] = {p: api_call(st, "admin", "GET", p).status_code for p in paths}
    broken = {p: c for p, c in report["baseline_old_release"].items() if c != 200}
    if broken:  # an old-release defect, not a deploy problem; recorded so the regression check can skip it
        log(f"  NOTE  old release already fails before the migration: {broken}")
    new_images = build_images(st, args.to_ref, args.platform, False)
    st.save()
    step("build new images", True, new_images["label"])
    proc = st.compose("run", "--rm", "--no-deps", "-T", "migrate", images=new_images, capture=True, check=False)
    step("migrate task with NEW image while OLD tasks serve", proc.returncode == 0, (proc.stdout + proc.stderr).strip().splitlines()[-1:] or "")
    # Invariant: whatever the old tasks served before the migration, they still serve after it.
    for path in paths:
        before, now = report["baseline_old_release"][path], api_call(st, "admin", "GET", path).status_code
        step(f"OLD backend on NEW schema: GET {path}", now == 200 or before != 200,
             str(now) if before == 200 else f"{now} (was {before} before the migration: an old-release defect)")
    st.data["images"] = new_images
    st.save()
    st.compose("up", "-d", "--remove-orphans")
    wait_healthy(st, args.timeout)
    step("roll services to new images", True, new_images["backend"])
    for path in paths:
        code = api_call(st, "admin", "GET", path).status_code
        step(f"NEW backend: GET {path}", code == 200, str(code))
    total = api_call(st, "admin", "GET", f"/projects/{pid}/data/patients?limit=5").json().get("total")
    step("data survives the roll", total == SAMPLE_PATIENTS, f"patients={total}")
    report["ok"] = True
    (st.evidence / f"deploy-rehearsal-{stamp()}.json").write_text(json.dumps(report, indent=2))
    emit(args, report, f"deploy rehearsal {from_ref[:12]} -> {new_images['label']}: PASS ({len(report['steps'])} steps)")
    return 0


