def redact(text: str) -> str:
    """The repo is public: keep account IDs and internal hostnames out of the transcript."""
    text = re.sub(r"(?<![0-9a-fA-F])\d{12}(?![0-9a-fA-F])", "<account>", text)
    return re.sub(r"\b[\w.-]+\.elb\.amazonaws\.com\b", "<alb-dns>", text)


def aws(args, *a, missing_ok: str | None = None) -> dict:
    cmd = ["aws", *a, "--profile", args.profile, "--region", args.region, "--output", "json"]
    log(redact("+ " + " ".join(cmd)))
    proc = run(cmd, capture=True, check=False, timeout=60, quiet=True)
    if proc.returncode != 0:
        err = redact(proc.stderr.strip())
        if missing_ok and missing_ok in err:
            return {}
        if re.search(r"expired|Token|credentials|SSO|ExpiredToken|InvalidClientTokenId", err, re.I):
            raise CliError(f"AWS credentials for profile '{args.profile}' are missing or expired. "
                           f"Ask the user to refresh them (e.g. `! aws sso login --profile {args.profile}` or their SAML login), then retry.\n{err[-400:]}")
        raise CheckFailed(f"aws {' '.join(a[:2])} failed: {err[-600:]}")
    return json.loads(proc.stdout or "{}")


def deployed_shas(args) -> dict:
    """Map service -> image tags/digest actually running (read-only describe/list calls)."""
    cluster = args.cluster
    names = [f"{AWS_PREFIX}-{s}" for s in ("backend", "worker", "frontend")]
    svcs = aws(args, "ecs", "describe-services", "--cluster", cluster, "--services", *names)["services"]
    out = {}
    for s in svcs:
        short = s["serviceName"].removeprefix(f"{AWS_PREFIX}-")
        tasks = aws(args, "ecs", "list-tasks", "--cluster", cluster, "--service-name", s["serviceName"], "--desired-status", "RUNNING")["taskArns"]
        digests, sidecars = set(), set()
        if tasks:
            for t in aws(args, "ecs", "describe-tasks", "--cluster", cluster, "--tasks", *tasks[:10])["tasks"]:
                for c in t.get("containers", []):
                    # Only the app container. AWS injects sidecars (aws-guardduty-agent-*) with no image name.
                    if c.get("imageDigest") and ".dkr.ecr." in (c.get("image") or ""):
                        digests.add(c["imageDigest"])
                    elif c.get("name"):
                        sidecars.add(re.sub(r"-[A-Za-z0-9]{4,8}$", "-*", c["name"]))
        repo = f"{AWS_PREFIX}-{'frontend' if short == 'frontend' else 'backend'}"
        tags, gone = set(), []
        for d in digests:
            imgs = aws(args, "ecr", "describe-images", "--repository-name", repo, "--image-ids", f"imageDigest={d}",
                       missing_ok="ImageNotFoundException").get("imageDetails")
            if imgs is None:
                gone.append(d[:19])  # task still runs an image ECR no longer has (overwritten tag + lifecycle expiry)
            for img in imgs or []:
                tags.update(img.get("imageTags", []))
        deploy = next((d for d in s.get("deployments", []) if d.get("status") == "PRIMARY"), {})
        out[short] = {
            "desired": s.get("desiredCount"), "running": s.get("runningCount"), "pending": s.get("pendingCount"),
            "rollout": deploy.get("rolloutState"), "task_def_revision": s.get("taskDefinition", "").rsplit(":", 1)[-1],
            "image_tags": sorted(tags), "digests": sorted(d[:19] for d in digests), "digests_not_in_ecr": gone, "sidecars": sorted(sidecars),
            "sha": next((t for t in sorted(tags) if re.fullmatch(r"[0-9a-f]{7,40}", t)), None),
        }
    return out


def cmd_aws_status(args) -> int:
    st = State(args)
    ident = aws(args, "sts", "get-caller-identity")
    services = deployed_shas(args)
    lb = aws(args, "elbv2", "describe-load-balancers", "--names", f"{AWS_PREFIX}-alb")["LoadBalancers"][0]
    tgs = aws(args, "elbv2", "describe-target-groups", "--load-balancer-arn", lb["LoadBalancerArn"])["TargetGroups"]
    health = {}
    for tg in tgs:
        states = [d["TargetHealth"]["State"] for d in aws(args, "elbv2", "describe-target-health", "--target-group-arn", tg["TargetGroupArn"])["TargetHealthDescriptions"]]
        health[tg["TargetGroupName"].removeprefix(f"{AWS_PREFIX}-")] = {s: states.count(s) for s in set(states)}
    head = git(st.root_repo, "rev-parse", "HEAD")
    for name, s in services.items():
        sha = s.get("sha")
        if not sha:
            continue
        paths = ["frontend"] if name == "frontend" else ["backend"]
        known = subprocess.run(["git", "-C", str(st.root_repo), "cat-file", "-e", f"{sha}^{{commit}}"]).returncode == 0
        s["in_local_history"] = known
        if known:
            s["is_ancestor_of_head"] = subprocess.run(["git", "-C", str(st.root_repo), "merge-base", "--is-ancestor", sha, head]).returncode == 0
            s["undeployed_commits"] = git(st.root_repo, "log", "--oneline", f"{sha}..{head}", "--", *paths).splitlines()[:20]
            if name == "backend":
                s["undeployed_migrations"] = git(st.root_repo, "diff", "--name-only", f"{sha}..{head}", "--", "backend/migrations/versions").splitlines()
    data = {"profile": args.profile, "arn_role": ident.get("Arn", "").split("/")[1] if "/" in ident.get("Arn", "") else "?",
            "cluster": args.cluster, "head": head[:12], "services": services, "target_health": health,
            "alb_scheme": lb.get("Scheme")}
    lines = [f"AWS {args.cluster} (profile {args.profile}, read-only), local HEAD {head[:12]}"]
    for name, s in services.items():
        lines.append(f"  {name:<8} {s['running']}/{s['desired']} running, rollout {s['rollout']}, taskdef rev {s['task_def_revision']}, "
                     f"image {s.get('sha') or s['image_tags']}, {len(s['digests'])} digest(s)"
                     + (f", sidecars {', '.join(s['sidecars'])}" if s["sidecars"] else ""))
        if s["digests_not_in_ecr"]:
            lines.append(f"           WARNING: {len(s['digests_not_in_ecr'])} running task(s) use an image no longer in ECR "
                         f"({', '.join(s['digests_not_in_ecr'])}); tasks are on mixed builds, and a replacement task will pull something else")
        if s.get("undeployed_commits") is not None:
            lines.append(f"           {len(s['undeployed_commits'])} commit(s) on HEAD touching {name if name == 'frontend' else 'backend'}/ not deployed"
                         + (f", {len(s.get('undeployed_migrations', []))} new migration file(s)" if name == "backend" else ""))
            lines += [f"             {c}" for c in s["undeployed_commits"][:8]]
    lines.append("  target health: " + "  ".join(f"{k} {v}" for k, v in health.items()))
    emit(args, data, "\n".join(lines))
    return 0


def cmd_bedrock_probe(args) -> int:
    """Classify two synthetic excerpts with real Bedrock inside the deployed-arch backend image. Costs money."""
    if not args.yes_cost:
        raise CliError("bedrock probe makes 2 paid Bedrock calls with real AWS credentials. Ask the user first, "
                       "then rerun with --yes-cost.")
    st = State(args)
    image = args.image or (st.data.get("images") or {}).get("backend")
    if not image or not image_exists(image):
        raise CliError("no backend image; run `control-cedars stack up` first, or pass --image")
    script = r'''
import asyncio, json, sys
from types import SimpleNamespace
from app.pipeline.classifier import classify_patient
cfg = SimpleNamespace(name="Deep vein thrombosis", description="Objectively confirmed DVT",
    include_criteria="Duplex ultrasound showing thrombus", exclude_criteria="Rule-out studies, family history",
    llm_provider="bedrock", llm_model=sys.argv[1], llm_api_base=None, llm_api_key=None)
cases = {
  "positive": [{"note_id": "n1", "note_date": "2020-03-04", "text": "Duplex ultrasound shows occlusive thrombus in the left femoral vein, consistent with acute DVT. Started apixaban."}],
  "negative": [{"note_id": "n2", "note_date": "2020-05-06", "text": "Bilateral lower extremity duplex: no evidence of deep vein thrombosis. DVT ruled out."}],
}
out = {}
for name, ex in cases.items():
    try:
        r = asyncio.run(classify_patient(ex, cfg))
        out[name] = {"label": r.label, "confidence": r.confidence, "score": r.score, "event_date": r.event_date,
                     "reasoning_present": bool(r.reasoning), "token_usage": r.token_usage}
    except Exception as e:
        out[name] = {"error": f"{type(e).__name__}: {e}"[:400]}
print(json.dumps(out))
'''
    plat = (st.data.get("images") or {}).get("platform", "linux/amd64")
    cmd = ["docker", "run", "--rm", "--platform", plat, "-v", f"{Path.home() / '.aws'}:/root/.aws:ro",
           "-e", f"AWS_PROFILE={args.profile}", "-e", f"AWS_REGION={args.region}", "-e", f"AWS_DEFAULT_REGION={args.region}",
           image, "uv", "run", "python", "-c", script, args.model]
    proc = run(cmd, capture=True, check=False, timeout=600)
    line = next((ln for ln in reversed(proc.stdout.splitlines()) if ln.startswith("{")), None)
    if not line:
        raise CheckFailed(f"probe produced no result (exit {proc.returncode}):\n{proc.stderr[-1500:]}")
    res = json.loads(line)
    ok = res.get("positive", {}).get("label") == "positive" and res.get("negative", {}).get("label") == "negative"
    (st.evidence / f"bedrock-probe-{stamp()}.json").write_text(json.dumps({"model": args.model, "image": image, "result": res}, indent=2))
    emit(args, {"ok": ok, "model": args.model, "image": image, "result": res},
         f"bedrock probe ({args.model}) in {image}:\n" + "\n".join(f"  {k}: {v}" for k, v in res.items())
         + f"\nbedrock probe: {'PASS' if ok else 'FAIL'}")
    return 0 if ok else 1


