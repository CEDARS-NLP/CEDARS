class CliError(Exception):
    """Precondition or usage problem; message must say how to fix it."""


class CheckFailed(Exception):
    """A verification check ran and failed."""


# --------------------------------------------------------------------------- utils


def log(msg: str) -> None:
    print(msg, file=sys.stderr, flush=True)


def run(cmd, *, check=True, capture=False, env=None, cwd=None, timeout=None, quiet=False, input=None):
    """Run a command and echo it so the transcript shows exactly what ran."""
    if not quiet:
        log("+ " + " ".join(str(c) for c in cmd))
    full_env = {**os.environ, **(env or {})}
    try:
        proc = subprocess.run(
            [str(c) for c in cmd],
            cwd=cwd,
            env=full_env,
            text=True,
            capture_output=capture,
            timeout=timeout,
            input=input,
        )
    except FileNotFoundError:
        raise CliError(f"{cmd[0]} is not installed or not on PATH. Run `control-cedars doctor`.")
    if check and proc.returncode != 0:
        detail = (proc.stderr or proc.stdout or "").strip()[-2000:] if capture else ""
        raise CheckFailed(f"command failed ({proc.returncode}): {' '.join(map(str, cmd))}\n{detail}")
    return proc


def run_logged(cmd, log_path: Path, *, cwd=None, env=None, timeout=None) -> int:
    """Run a command streaming to a log file; return exit code and print the tail on failure."""
    log("+ " + " ".join(str(c) for c in cmd) + f"   (log: {log_path})")
    log_path.parent.mkdir(parents=True, exist_ok=True)
    with open(log_path, "w") as fh:
        proc = subprocess.run(
            [str(c) for c in cmd], cwd=cwd, env={**os.environ, **(env or {})},
            stdout=fh, stderr=subprocess.STDOUT, text=True, timeout=timeout,
        )
    return proc.returncode


def tail(path: Path, n: int = 25) -> str:
    try:
        return "\n".join(path.read_text(errors="replace").splitlines()[-n:])
    except OSError:
        return ""


def emit(args, data, human: str | None = None) -> None:
    """Machine output on stdout: JSON with --json, else the human text (or JSON if none)."""
    if getattr(args, "json", False) or human is None:
        print(json.dumps(data, indent=2, default=str))
    else:
        print(human)


def slugify(text: str) -> str:
    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")[:40] or "default"


def port_free(port: int) -> bool:
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            s.bind(("127.0.0.1", port))
            return True
        except OSError:
            return False


def now_iso() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def stamp() -> str:
    return datetime.now().strftime("%Y%m%d-%H%M%S")


# --------------------------------------------------------------------------- repo + state


def repo_root(args) -> Path:
    if args.repo:
        root = Path(args.repo).resolve()
    else:
        proc = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True)
        root = Path(proc.stdout.strip()) if proc.returncode == 0 else SKILL_DIR.parents[2]
    if not (root / "backend" / "app" / "main.py").exists() or not (root / "infra" / "cedars-v2").exists():
        raise CliError(f"{root} is not a CEDARS v2 checkout (no backend/app/main.py or infra/cedars-v2). Pass --repo PATH.")
    return root


def git(root: Path, *a, check=True) -> str:
    proc = subprocess.run(["git", "-C", str(root), *a], capture_output=True, text=True)
    if check and proc.returncode != 0:
        raise CliError(f"git {' '.join(a)} failed: {proc.stderr.strip()}")
    return proc.stdout.strip()


class State:
    """Per-instance state under /tmp/cedars-verify/<instance>; evidence survives cleanup."""

    def __init__(self, args):
        self.args = args
        self.root_repo = repo_root(args)
        self.instance = slugify(args.instance or os.environ.get("CEDARS_VERIFY_INSTANCE") or self.root_repo.name)
        self.project = f"cedars-verify-{self.instance}"
        self.dir = STATE_ROOT / self.instance
        self.file = self.dir / "state.json"
        self.evidence = self.dir / "evidence"
        self.control = self.dir / "control"
        self.cookies = self.dir / "cookies"
        self.logs = self.dir / "logs"
        self.src = self.dir / "src"
        self.data = json.loads(self.file.read_text()) if self.file.exists() else {}

    @property
    def exists(self) -> bool:
        return bool(self.data)

    def init(self) -> None:
        for d in (self.evidence, self.control, self.cookies, self.logs, self.src):
            d.mkdir(parents=True, exist_ok=True)
        if not self.data:
            self.data = {
                "instance": self.instance,
                "project": self.project,
                "repo": str(self.root_repo),
                "created_at": now_iso(),
                "secrets": {
                    "db_password": secrets.token_hex(16),  # rds.tf: 32 chars, special=false
                    "secret_key": secrets.token_hex(32),  # secrets.tf: 64 chars, special=false
                    "s3_user": "verify" + secrets.token_hex(4),
                    "s3_password": secrets.token_hex(16),
                    "user_password": "Verify-" + secrets.token_urlsafe(12),
                },
            }
        mode = self.control / "mode"
        if not mode.exists():
            mode.write_text("normal\n")
        self.save()

    def save(self) -> None:
        self.dir.mkdir(parents=True, exist_ok=True)
        self.file.write_text(json.dumps(self.data, indent=2))

    def require_stack(self) -> None:
        if not self.data.get("images"):
            raise CliError(f"no stack for instance '{self.instance}'. Run `control-cedars stack up` first.")

    @property
    def port(self) -> int:
        return int(self.data["port"])

    @property
    def url(self) -> str:
        return f"http://127.0.0.1:{self.port}"

    def compose_env(self, images: dict | None = None) -> dict:
        s = self.data["secrets"]
        imgs = images or self.data.get("images", {})
        return {
            "CV_PROJECT": self.project,
            "CV_PORT": str(self.data.get("port", 0)),
            "CV_BUCKET": BUCKET,
            "CV_DB_PASSWORD": s["db_password"],
            "CV_SECRET_KEY": s["secret_key"],
            "CV_S3_USER": s["s3_user"],
            "CV_S3_PASSWORD": s["s3_password"],
            "CV_BACKEND_IMAGE": imgs.get("backend", "cedars-verify/backend:unset"),
            "CV_FRONTEND_IMAGE": imgs.get("frontend", "cedars-verify/frontend:unset"),
            "CV_PLATFORM": imgs.get("platform", "linux/amd64"),
            "CV_STACK_DIR": str(STACK_DIR),
            "CV_CONTROL_DIR": str(self.control),
            "CV_EVIDENCE_DIR": str(self.evidence),
            "CV_NO_EGRESS": "true" if self.data.get("no_egress") else "false",
        }

    def compose(self, *a, images=None, **kw):
        cmd = ["docker", "compose", "-p", self.project, "-f", str(COMPOSE_FILE), *a]
        return run(cmd, env=self.compose_env(images), **kw)


def derive_port(instance: str) -> int:
    base = 18000 + zlib.crc32(instance.encode()) % 900
    for p in range(base, base + 100):
        if port_free(p):
            return p
    raise CliError("no free port in 18000-19000; pass --port N")


def resolve_platform(name: str) -> str:
    if name == "amd64":
        return "linux/amd64"
    if name == "native":
        machine = pyplatform.machine().lower()
        return "linux/arm64" if machine in ("arm64", "aarch64") else "linux/amd64"
    raise CliError("--platform must be amd64 or native")


# --------------------------------------------------------------------------- images


def source_tree(st: State, ref: str | None) -> tuple[Path, str, str]:
    """Return (path, sha, label) for the working tree or a detached worktree at ref."""
    root = st.root_repo
    if not ref or ref == "worktree":
        sha = git(root, "rev-parse", "HEAD")
        dirty = git(root, "status", "--porcelain", "--", "backend", "frontend")
        label = f"wt-{sha[:12]}"
        if dirty:
            # Hash the uncommitted changes so sessions with different edits never share (and retag) one image.
            h = hashlib.sha256(git(root, "diff", "HEAD", "--binary", "--", "backend", "frontend").encode())
            for f in git(root, "ls-files", "--others", "--exclude-standard", "--", "backend", "frontend").splitlines():
                h.update(f.encode() + (root / f).read_bytes())
            label += f"-dirty{h.hexdigest()[:8]}"
        return root, sha, label
    sha = git(root, "rev-parse", "--verify", f"{ref}^{{commit}}")
    path = st.src / sha[:12]
    if not (path / "backend").exists():
        st.src.mkdir(parents=True, exist_ok=True)
        run(["git", "-C", str(root), "worktree", "add", "--detach", str(path), sha])
    return path, sha, sha[:12]


def image_exists(name: str) -> bool:
    return subprocess.run(["docker", "image", "inspect", name], capture_output=True).returncode == 0


def build_images(st: State, ref: str | None, platform_name: str, force: bool) -> dict:
    """docker build --platform linux/amd64 for backend + frontend, as the deploy runbook does."""
    src, sha, label = source_tree(st, ref)
    plat = resolve_platform(platform_name)
    suffix = "amd64" if plat == "linux/amd64" else "native"
    images = {
        "backend": f"cedars-verify/backend:{label}-{suffix}",
        "frontend": f"cedars-verify/frontend:{label}-{suffix}",
        "platform": plat,
        "sha": sha,
        "label": label,
        "src": str(src),
        "ref": ref or "worktree",
    }
    worktree_build = label.startswith("wt-")
    jobs = {}
    with concurrent.futures.ThreadPoolExecutor(max_workers=2) as pool:
        for part in ("backend", "frontend"):
            if not force and not worktree_build and image_exists(images[part]):
                log(f"= {images[part]} already built")
                continue
            logf = st.logs / f"build-{part}-{label}-{suffix}.log"
            # The label lets cleanup find builds whose tag a later rebuild moved (dangling, but still ours).
            cmd = ["docker", "build", "--platform", plat, "--label", "cedars-verify=1", "-t", images[part], str(src / part)]
            jobs[part] = (pool.submit(run_logged, cmd, logf, timeout=3600), logf)
        started = time.time()
        for part, (fut, logf) in jobs.items():
            if fut.result() != 0:
                raise CheckFailed(f"{part} image build failed. Tail of {logf}:\n{tail(logf)}")
        if jobs:
            log(f"= built {', '.join(jobs)} in {time.time() - started:.0f}s ({plat})")
    images["built"] = sorted(set(st.data.get("built_images", [])) | {images["backend"], images["frontend"]})
    st.data["built_images"] = images.pop("built")
    return images


# --------------------------------------------------------------------------- stack


def compose_ps(st: State) -> list[dict]:
    proc = st.compose("ps", "-a", "--format", "json", capture=True, quiet=True, check=False)
    out = proc.stdout.strip()
    if not out:
        return []
    if out.startswith("["):
        return json.loads(out)
    return [json.loads(line) for line in out.splitlines() if line.strip()]


def http_status(url: str, timeout: float = 5.0) -> int:
    import httpx

    try:
        return httpx.get(url, timeout=timeout).status_code
    except httpx.HTTPError:
        return 0


def worker_heartbeat(st: State) -> bool:
    proc = st.compose("exec", "-T", "redis", "redis-cli", "EXISTS", "arq:queue:health-check",
                      capture=True, quiet=True, check=False)
    return proc.stdout.strip() == "1"


def wait_healthy(st: State, timeout: int) -> dict:
    """Wait like the deploy runbook: migrate exits 0, then ALB target health (2 consecutive 200s)."""
    deadline = time.time() + timeout
    t0 = time.time()
    result = {"migrate": None, "alb_api": None, "alb_frontend": None, "worker_heartbeat": None}
    while time.time() < deadline:
        ps = {c["Service"]: c for c in compose_ps(st) if c.get("Service") in ("migrate", "s3-init")}
        bad = [s for s, c in ps.items() if c.get("State") == "exited" and c.get("ExitCode") not in (0, None)]
        if bad:
            for s in bad:
                st.compose("logs", "--no-color", "--tail", "60", s, check=False)
            raise CheckFailed(f"one-off task(s) failed: {', '.join(bad)} (logs above)")
        if ps.get("migrate", {}).get("State") == "exited":
            result["migrate"] = "exit 0"
            break
        time.sleep(2)
    else:
        raise CheckFailed(f"migrate did not finish in {timeout}s; see `control-cedars stack logs migrate`")
    consecutive = 0
    while time.time() < deadline:
        code = http_status(f"{st.url}/api/v1/health")
        consecutive = consecutive + 1 if code == 200 else 0
        if consecutive >= 2:  # alb.tf healthy_threshold = 2
            result["alb_api"] = 200
            break
        time.sleep(3)
    else:
        raise CheckFailed(f"ALB /api/v1/health not healthy in {timeout}s; see `control-cedars stack logs backend`")
    result["alb_frontend"] = http_status(f"{st.url}/")
    if result["alb_frontend"] != 200:
        # A crash-looping frontend task (e.g. nginx `host not found in upstream`) shows up as a 502 here.
        proc = st.compose("logs", "--no-color", "--tail", "40", "frontend", capture=True, quiet=True, check=False)
        emerg = sorted({ln.split("|", 1)[-1].strip() for ln in proc.stdout.splitlines() if "[emerg]" in ln})
        cause = f": frontend crashed with {emerg[-1]}" if emerg else ""
        raise CheckFailed(f"ALB / returned {result['alb_frontend']}{cause}; see `control-cedars stack logs frontend`")
    while time.time() < deadline:
        if worker_heartbeat(st):
            result["worker_heartbeat"] = True
            break
        time.sleep(3)
    else:
        raise CheckFailed("worker never wrote arq:queue:health-check; see `control-cedars stack logs worker`")
    result["seconds"] = round(time.time() - t0)
    return result


def cmd_stack_up(args) -> int:
    st = State(args)
    st.init()
    running = any(c.get("State") == "running" for c in compose_ps(st))
    if args.port:
        st.data["port"] = args.port
    elif not st.data.get("port") or (not running and not port_free(st.data["port"])):
        st.data["port"] = derive_port(st.instance)
    if not running and not port_free(st.port):
        raise CliError(f"port {st.port} is in use by something else; pass --port N")
    st.data["no_egress"] = bool(args.no_egress)
    if args.no_build:
        images = st.data.get("images")
        if not images or not all(image_exists(images[p]) for p in ("backend", "frontend")):
            raise CliError("--no-build given but no images are recorded/present; drop --no-build")
    else:
        images = build_images(st, args.ref, args.platform, args.rebuild)
    st.data["images"] = images
    st.save()
    t_up = time.time()
    st.compose("up", "-d", "--remove-orphans")
    health = wait_healthy(st, args.timeout)
    health["seconds"] = round(time.time() - t_up)
    st.data["up_at"] = now_iso()
    st.save()
    data = {"url": st.url, "instance": st.instance, "images": images, "health": health,
            "evidence": str(st.evidence), "no_egress": st.data["no_egress"]}
    note = "" if images["platform"] == "linux/amd64" else "\nWARNING: native platform; Fargate runs linux/amd64. Say so in the report."
    emit(args, data, f"stack up: {st.url}\n  source  {images['ref']} @ {images['sha'][:12]} ({images['label']})\n"
         f"  images  {images['backend']}  {images['frontend']}\n  health  migrate {health['migrate']}, "
         f"ALB /api/v1/health 200 x2, / 200, worker heartbeat ok ({health['seconds']}s)\n"
         f"  evidence {st.evidence}{note}\nnext: control-cedars seed")
    return 0


def cmd_stack_status(args) -> int:
    st = State(args)
    st.require_stack()
    ps = compose_ps(st)
    services: dict[str, list] = {}
    for c in ps:
        services.setdefault(c["Service"], []).append(
            {"name": c.get("Name"), "state": c.get("State"), "health": c.get("Health") or "", "exit": c.get("ExitCode")}
        )
    up = any(c.get("State") == "running" for c in ps)
    data = {
        "instance": st.instance,
        "url": st.url,
        "up": up,
        "images": st.data.get("images"),
        "services": services,
        "alb_api_health": http_status(f"{st.url}/api/v1/health") if up else None,
        "alb_frontend": http_status(f"{st.url}/") if up else None,
        "worker_heartbeat": worker_heartbeat(st) if up else None,
        "llm_mode": (st.control / "mode").read_text().strip() if (st.control / "mode").exists() else None,
        "last_seed": st.data.get("last_seed"),
    }
    lines = [f"{st.project}: {'UP' if up else 'DOWN'}  {st.url}",
             f"  source {data['images'].get('ref')} @ {data['images'].get('sha', '')[:12]}  platform {data['images'].get('platform')}"]
    for svc in sorted(services):
        reps = services[svc]
        states = ", ".join(f"{r['state']}{'/' + r['health'] if r['health'] else ''}{'' if r['exit'] in (0, None) or r['state'] == 'running' else ' exit ' + str(r['exit'])}" for r in reps)
        lines.append(f"  {svc:<9} x{len(reps)}  {states}")
    if up:
        lines.append(f"  ALB /api/v1/health {data['alb_api_health']}  / {data['alb_frontend']}  worker heartbeat {data['worker_heartbeat']}  llm mode {data['llm_mode']}")
    emit(args, data, "\n".join(lines))
    return 0 if up else 1


def cmd_stack_logs(args) -> int:
    st = State(args)
    st.require_stack()
    cmd = ["logs", "--no-color", "--timestamps", "--tail", str(args.tail)]
    if args.since:
        cmd += ["--since", args.since]
    proc = st.compose(*cmd, *args.service, capture=bool(args.grep), check=False)
    if args.grep:
        pat = re.compile(args.grep, re.I)
        hits = [ln for ln in (proc.stdout + proc.stderr).splitlines() if pat.search(ln)]
        print("\n".join(hits))
        return 0 if hits else 1
    return proc.returncode


def cmd_stack_restart(args) -> int:
    st = State(args)
    st.require_stack()
    st.compose("restart", *args.service)
    if "backend" in args.service or "alb" in args.service:
        consecutive, deadline = 0, time.time() + args.timeout
        while time.time() < deadline and consecutive < 2:
            consecutive = consecutive + 1 if http_status(f"{st.url}/api/v1/health") == 200 else 0
            time.sleep(3)
        if consecutive < 2:
            raise CheckFailed("backend not healthy behind the ALB after restart")
    emit(args, {"restarted": args.service}, f"restarted {' '.join(args.service)}")
    return 0


def cmd_stack_down(args) -> int:
    st = State(args)
    if not st.exists:
        emit(args, {"down": True, "note": "no state"}, f"nothing to stop for instance '{st.instance}'")
        return 0
    down = ["down", "--remove-orphans"] + ([] if args.keep_volumes else ["-v"])
    st.compose(*down, check=False)
    if not args.keep_volumes and st.data.pop("last_seed", None):
        st.save()  # the seeded project died with the volume; {project} must not expand to it
    emit(args, {"down": True, "volumes_removed": not args.keep_volumes, "evidence": str(st.evidence)},
         f"stack down ({'volumes kept' if args.keep_volumes else 'volumes removed'}); evidence kept at {st.evidence}")
    return 0


# --------------------------------------------------------------------------- db + migrations


def psql_ro(st: State, sql: str, *flags, quiet=False):
    """psql in the stack's postgres with default_transaction_read_only=on."""
    return run(
        ["docker", "compose", "-p", st.project, "-f", str(COMPOSE_FILE), "exec", "-T",
         "-e", "PGOPTIONS=-c default_transaction_read_only=on", "postgres",
         "psql", "-U", "cedars", "-d", "cedars", "-v", "ON_ERROR_STOP=1", "-P", "pager=off", *flags, "-c", sql],
        env=st.compose_env(), check=False, capture=True, quiet=quiet,
    )


def cmd_db_query(args) -> int:
    st = State(args)
    st.require_stack()
    sql = expand_path_ui(st, sys.stdin.read() if args.sql == "-" else args.sql)  # {project}/{source} are seeded UUIDs, safe to inline
    proc = psql_ro(st, sql, *(["--csv"] if args.csv else []))
    sys.stdout.write(proc.stdout)
    if proc.returncode != 0:
        log(proc.stderr.strip())
        if "read-only transaction" in proc.stderr:
            log("db query is read-only by design (CLAUDE.md: no ad-hoc data fixes). Change data through the UI or API.")
    return 0 if proc.returncode == 0 else 1


def alembic(st: State, *a, db_url: str | None = None, check=True, images=None):
    env_flags = ["-e", f"CEDARS_DATABASE_URL={db_url}"] if db_url else []
    return st.compose("run", "--rm", "--no-deps", "-T", *env_flags, "migrate", "uv", "run", "alembic", *a,
                      capture=True, check=check, images=images)


def cmd_migrate_status(args) -> int:
    st = State(args)
    st.require_stack()
    current = alembic(st, "current").stdout.strip().splitlines()
    heads = alembic(st, "heads").stdout.strip().splitlines()
    cur = [ln.split()[0] for ln in current if re.match(r"^[0-9a-f]{6,}", ln)]
    hd = [ln.split()[0] for ln in heads if re.match(r"^[0-9a-f]{6,}", ln)]
    ok = len(hd) == 1 and cur == hd
    emit(args, {"current": cur, "heads": hd, "at_head": ok},
         f"alembic current {cur or 'none'}  heads {hd}  -> {'at head' if ok else 'NOT at single head'}")
    return 0 if ok else 1


def cmd_migrate_check(args) -> int:
    """Fresh DB: upgrade head, single head, downgrade -1, re-upgrade, alembic check (models == migrations)."""
    st = State(args)
    st.require_stack()
    scratch = "cedars_migrate_check"
    url = f"postgresql+asyncpg://cedars:{st.data['secrets']['db_password']}@postgres:5432/{scratch}"
    psql = ["exec", "-T", "postgres", "psql", "-U", "cedars", "-d", "postgres", "-v", "ON_ERROR_STOP=1"]
    st.compose(*psql, "-c", f"DROP DATABASE IF EXISTS {scratch}", "-c", f"CREATE DATABASE {scratch}", capture=True)
    steps = []
    try:
        for label, a in [("upgrade head", ("upgrade", "head")), ("heads", ("heads",)),
                         ("downgrade -1", ("downgrade", "-1")), ("re-upgrade head", ("upgrade", "head")),
                         ("check (models vs migrations)", ("check",))]:
            proc = alembic(st, *a, db_url=url, check=False)
            out = (proc.stdout + proc.stderr).strip()
            ok = proc.returncode == 0
            if label == "heads":
                n = len([ln for ln in proc.stdout.splitlines() if re.match(r"^[0-9a-f]{6,}", ln)])
                ok = ok and n == 1
                out = f"{n} head(s): {proc.stdout.strip()}"
            steps.append({"step": label, "ok": ok, "detail": out.splitlines()[-1] if out else ""})
            if not ok and label != "check (models vs migrations)":
                break
    finally:
        st.compose(*psql, "-c", f"DROP DATABASE IF EXISTS {scratch}", capture=True, check=False)
    ok = all(s["ok"] for s in steps) and len(steps) == 5
    emit(args, {"ok": ok, "steps": steps},
         "\n".join(f"  {'PASS' if s['ok'] else 'FAIL'}  {s['step']}: {s['detail']}" for s in steps)
         + f"\nmigrate check: {'PASS' if ok else 'FAIL'}")
    return 0 if ok else 1


# --------------------------------------------------------------------------- CI parity tests


PYTEST_SUMMARY = re.compile(r"\b\d+ (passed|failed|errors?)\b.* in [\d.]+s")


def run_ci_steps(steps: list, cwd: Path, logf: Path, env: dict | None = None) -> list:
    """Run every step, even after a failure. CI stops at the first failure, so later steps are
    marked ci_skipped: their result is still useful, but real CI never saw it."""
    results, failed = [], False
    with open(logf, "w") as fh:
        for step in steps:
            log("+ " + " ".join(step) + f"   (cwd {cwd}, log {logf})")
            fh.write(f"\n$ {' '.join(step)}\n")
            fh.flush()
            rc = subprocess.run(step, cwd=cwd, env={**os.environ, **(env or {})},
                                stdout=fh, stderr=subprocess.STDOUT).returncode
            results.append({"step": " ".join(step), "exit": rc, "ci_skipped": failed})
            failed = failed or rc != 0
    return results


def step_lines(results: list) -> str:
    return "\n".join(f"  {'PASS' if r['exit'] == 0 else 'FAIL'}  {r['step']}"
                     + ("   (CI never runs this: an earlier step failed)" if r["ci_skipped"] else "")
                     for r in results)


def cmd_test_backend(args) -> int:
    st = State(args)
    st.init()
    src, sha, label = source_tree(st, args.ref)
    cwd = src / "backend"
    mode = "postgres" if args.postgres else "sqlite"
    logf = st.evidence / f"test-backend-{mode}-{label}-{stamp()}.log"
    env, container = {"UV_PYTHON": "3.12"}, None  # CI runs `uv python install 3.12` first
    # .github/workflows/backend-v2.yml, job by job.
    steps = [["uv", "sync", "--extra", "dev"]]
    if args.postgres:
        container = f"{st.project}-ci-pg"
        run(["docker", "rm", "-f", container], check=False, capture=True, quiet=True)
        run(["docker", "run", "-d", "--name", container, "-e", "POSTGRES_DB=cedars", "-e", "POSTGRES_USER=cedars",
             "-e", "POSTGRES_PASSWORD=cedars", "-p", "127.0.0.1::5432", CI_POSTGRES_IMAGE], capture=True)
        port = run(["docker", "port", container, "5432/tcp"], capture=True).stdout.strip().splitlines()[0].rsplit(":", 1)[1]
        for _ in range(60):
            if run(["docker", "exec", container, "pg_isready", "-U", "cedars"], check=False, capture=True, quiet=True).returncode == 0:
                break
            time.sleep(1)
        env |= {"CEDARS_TEST_POSTGRES": "1",
                "CEDARS_TEST_POSTGRES_URL": f"postgresql+asyncpg://cedars:cedars@127.0.0.1:{port}/cedars"}
        steps.append(["uv", "run", "pytest", "tests/", "-q", *args.pytest_args])
    else:
        steps.append(["uv", "run", "ruff", "check", "app"])
        steps.append(["uv", "run", "pytest", "tests/", "--cov=app", "--cov-report=term-missing", *args.pytest_args])
    try:
        results = run_ci_steps(steps, cwd, logf, env)
    finally:
        if container:
            run(["docker", "rm", "-f", container], check=False, capture=True)
    log_text = tail(logf, 400).splitlines()
    summary = [ln.strip("= ") for ln in log_text if PYTEST_SUMMARY.search(ln)]
    failures = [ln for ln in log_text if ln.startswith(("FAILED ", "ERROR "))]
    ok = all(r["exit"] == 0 for r in results)
    emit(args, {"ok": ok, "mode": mode, "source": label, "steps": results, "summary": summary[-1:],
                "failures": failures, "log": str(logf)},
         step_lines(results) + (f"\n  pytest: {summary[-1]}" if summary else "")
         + "".join(f"\n  {f}" for f in failures)
         + f"\ntest backend ({mode}): {'PASS' if ok else 'FAIL'}  log {logf}")
    if not ok:
        log(tail(logf, 40))
    return 0 if ok else 1


def cmd_test_frontend(args) -> int:
    st = State(args)
    st.init()
    src, sha, label = source_tree(st, args.ref)
    cwd = src / "frontend"
    logf = st.evidence / f"test-frontend-{label}-{stamp()}.log"
    # There is no frontend CI workflow; these are the CLAUDE.md commands.
    steps = []
    if args.ci or not (cwd / "node_modules").exists():
        steps.append(["npm", "ci"])
    steps += [["npx", "tsc", "--noEmit"], ["npx", "eslint", "src/"], ["npm", "run", "build"]]
    results = run_ci_steps(steps, cwd, logf)
    ok = all(r["exit"] == 0 for r in results)
    emit(args, {"ok": ok, "source": label, "steps": results, "log": str(logf)},
         step_lines(results) + f"\ntest frontend: {'PASS' if ok else 'FAIL'}  log {logf}")
    if not ok:
        log(tail(logf, 40))
    return 0 if ok else 1


def cmd_test_all(args) -> int:
    rc = 0
    for fn, extra in ((cmd_test_backend, {"postgres": False}), (cmd_test_backend, {"postgres": True}),
                      (cmd_test_frontend, {"ci": False})):
        ns = argparse.Namespace(**{**vars(args), **extra})
        rc |= fn(ns)
    return rc


def gh_json(root: Path, *a, timeout=60):
    proc = run(["gh", *a], capture=True, check=False, cwd=root, timeout=timeout)
    if proc.returncode != 0:
        raise CliError(f"gh {' '.join(a[:2])} failed. Check `gh auth status` (read access to the repo is enough).\n"
                       f"{proc.stderr.strip()[-400:]}")
    return json.loads(proc.stdout or "null")


def cmd_ci_status(args) -> int:
    """Real GitHub Actions results for a workflow on a branch (read-only gh calls)."""
    st = State(args)
    root = st.root_repo
    branch = args.branch or git(root, "rev-parse", "--abbrev-ref", "HEAD")
    head = git(root, "rev-parse", "HEAD")
    runs = gh_json(root, "run", "list", "--workflow", args.workflow, "--branch", branch, "--limit", str(args.limit),
                   "--json", "databaseId,headSha,status,conclusion,createdAt,displayTitle")
    failed_tests: dict[str, int] = {}
    for r in runs:
        # A force-pushed branch keeps CI runs for commits that are no longer in its history.
        r["in_history"] = run(["git", "merge-base", "--is-ancestor", r["headSha"], head], cwd=root,
                              check=False, quiet=True).returncode == 0
        jobs = gh_json(root, "run", "view", str(r["databaseId"]), "--json", "jobs")["jobs"]
        r["jobs"] = [{"name": j["name"], "conclusion": j.get("conclusion"),
                      "failed_steps": [x["name"] for x in j.get("steps", []) if x.get("conclusion") == "failure"]}
                     for j in jobs]
        r["failed_tests"] = []
        if r.get("conclusion") == "failure":
            logp = run(["gh", "run", "view", str(r["databaseId"]), "--log-failed"], capture=True, check=False,
                       cwd=root, timeout=180)
            r["failed_tests"] = sorted({m.group(1) for m in re.finditer(r"FAILED (tests/\S+)", logp.stdout)})
            for t in r["failed_tests"] if r["in_history"] else []:
                failed_tests[t] = failed_tests.get(t, 0) + 1
    done = [r for r in runs if r.get("status") == "completed"]
    latest = done[0] if done else None
    head_run = next((r for r in runs if r["headSha"] == head), None)
    ok = bool(latest and latest.get("conclusion") == "success")
    data = {"workflow": args.workflow, "branch": branch, "head": head[:12], "runs": runs,
            "head_has_run": bool(head_run), "latest_completed_ok": ok, "failed_test_counts": failed_tests}
    lines = [f"{args.workflow} on {branch} (gh, read-only), local HEAD {head[:12]}"]
    for r in runs:
        lines.append(f"  {r['createdAt'][:10]} {r['headSha'][:8]} {r.get('conclusion') or r['status']:<9} {r['displayTitle'][:60]}"
                     + ("" if r["in_history"] else "  [NOT in local history: rewritten branch, ignored in counts]"))
        for j in r["jobs"]:
            if j["conclusion"] != "success":
                lines.append(f"      {j['name']}: {j['conclusion']}" + (f" at {', '.join(j['failed_steps'])}" if j["failed_steps"] else ""))
        lines += [f"        FAILED {t}" for t in r["failed_tests"][:10]]
    n_hist = sum(r["in_history"] for r in runs)
    if failed_tests:
        lines.append(f"  failing tests across {n_hist} run(s) in local history: "
                     + "; ".join(f"{t} ({n}/{n_hist})" for t, n in sorted(failed_tests.items(), key=lambda x: -x[1])))
    lines.append(f"  HEAD {'has a CI run' if head_run else 'has NO CI run (not pushed, or no backend/** change)'}; "
                 f"latest completed run: {latest.get('conclusion') if latest else 'none'}")
    emit(args, data, "\n".join(lines))
    return 0 if ok else 1


