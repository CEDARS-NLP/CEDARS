def locator(page, spec):
    """Locator from a string (Playwright selector) or a dict {role,name,exact|text|label|placeholder|css|testid, nth, within}."""
    if isinstance(spec, str):
        loc = page.locator(spec)
    else:
        root = locator(page, spec["within"]) if "within" in spec else page
        exact = spec.get("exact", False)
        if "role" in spec:
            loc = root.get_by_role(spec["role"], name=spec.get("name"), exact=exact) if "name" in spec else root.get_by_role(spec["role"])
        elif "text" in spec:
            loc = root.get_by_text(spec["text"], exact=exact)
        elif "label" in spec:
            loc = root.get_by_label(spec["label"], exact=exact)
        elif "placeholder" in spec:
            loc = root.get_by_placeholder(spec["placeholder"], exact=exact)
        elif "testid" in spec:
            loc = root.get_by_test_id(spec["testid"])
        elif "css" in spec:
            loc = root.locator(spec["css"])
        else:
            raise CliError(f"locator needs role/text/label/placeholder/testid/css: {spec}")
    if isinstance(spec, dict) and "nth" in spec:
        loc = loc.nth(spec["nth"])
    return loc


def browser_session(st: State, role: str | None, headed=False, slow_mo=0):
    from playwright.sync_api import sync_playwright

    pw = sync_playwright().start()
    browser = pw.chromium.launch(headless=not headed, slow_mo=slow_mo)
    context = browser.new_context(base_url=st.url, viewport={"width": 1440, "height": 900})
    if role:
        login(st, role)
        cookies = [{"name": c.name, "value": c.value, "domain": "127.0.0.1", "path": c.path,
                    "httpOnly": True, "sameSite": "Lax"} for c in jar_for(st, role)]
        context.add_cookies(cookies)
    page = context.new_page()
    events = {"console_errors": [], "page_errors": [], "api_errors": [], "failed_requests": []}
    page.on("console", lambda m: m.type == "error" and events["console_errors"].append(m.text[:300]))
    page.on("pageerror", lambda e: events["page_errors"].append(str(e)[:300]))
    page.on("response", lambda r: r.status >= 400 and "/api/" in r.url and events["api_errors"].append(f"{r.status} {r.request.method} {r.url.split(str(st.port), 1)[-1]}"))
    page.on("requestfailed", lambda r: events["failed_requests"].append(f"{r.method} {r.url.split(str(st.port), 1)[-1]} {r.failure}"))
    return pw, browser, page, events


def save_shot(st: State, page, name: str, full_page=False) -> str:
    path = st.evidence / f"{name}.png"
    page.screenshot(path=str(path), full_page=full_page)
    log(f"screenshot {path}")
    return str(path)


def run_steps(st: State, page, steps: list, prefix: str, default_timeout: float) -> list:
    shots = []
    for i, step in enumerate(steps, 1):
        timeout = float(step.get("timeout", default_timeout)) * 1000
        action = next((k for k in ("goto", "click", "fill", "select", "press", "check", "upload", "expect_text",
                                   "expect_no_text", "expect", "expect_url", "wait", "screenshot", "snapshot") if k in step), None)
        if not action:
            raise CliError(f"step {i} has no known action: {step}")
        log(f"  step {i}: {action} {json.dumps(step[action])[:120]}")
        try:
            if action == "goto":
                page.goto(step["goto"], timeout=timeout)
                page.wait_for_load_state("networkidle", timeout=timeout)
            elif action == "click":
                locator(page, step["click"]).click(timeout=timeout)
            elif action == "fill":
                locator(page, step["fill"]).fill(str(step["value"]), timeout=timeout)
            elif action == "select":
                loc = locator(page, step["select"])
                try:
                    loc.select_option(label=str(step["value"]), timeout=timeout)
                except Exception:  # noqa: BLE001 - fall back to option value
                    loc.select_option(value=str(step["value"]), timeout=timeout)
            elif action == "press":
                if "on" in step:
                    locator(page, step["on"]).press(step["press"], timeout=timeout)
                else:
                    page.keyboard.press(step["press"])
            elif action == "check":
                locator(page, step["check"]).check(timeout=timeout)
            elif action == "upload":
                f = Path(step["file"])
                f = f if f.is_absolute() else Path(st.data["images"]["src"]) / f
                locator(page, step["upload"]).set_input_files(str(f), timeout=timeout)
            elif action == "expect_text":
                page.get_by_text(step["expect_text"], exact=step.get("exact", False)).first.wait_for(state="visible", timeout=timeout)
            elif action == "expect_no_text":
                page.get_by_text(step["expect_no_text"], exact=step.get("exact", False)).first.wait_for(state="hidden", timeout=timeout)
            elif action == "expect":
                state = step.get("state", "visible")
                loc = locator(page, step["expect"]).first
                if state in ("visible", "hidden", "attached", "detached"):
                    loc.wait_for(state=state, timeout=timeout)
                else:
                    deadline = time.time() + timeout / 1000
                    while (loc.is_enabled() if state == "enabled" else loc.is_disabled()) is False:
                        if time.time() > deadline:
                            raise TimeoutError(f"not {state}")
                        time.sleep(0.25)
            elif action == "expect_url":
                page.wait_for_url(re.compile(step["expect_url"]), timeout=timeout)
            elif action == "wait":
                time.sleep(float(step["wait"]))
            elif action == "screenshot":
                shots.append(save_shot(st, page, f"{prefix}-{step['screenshot']}", step.get("full_page", False)))
            elif action == "snapshot":
                snap = page.locator("body").aria_snapshot()
                p = st.evidence / f"{prefix}-{step['snapshot']}.aria.yml"
                p.write_text(snap)
                log(f"aria snapshot {p}")
        except Exception as e:  # noqa: BLE001 - every failure gets evidence
            shots.append(save_shot(st, page, f"{prefix}-FAIL-step{i}", True))
            (st.evidence / f"{prefix}-FAIL-step{i}.aria.yml").write_text(page.locator("body").aria_snapshot())
            raise CheckFailed(f"step {i} ({action}) failed: {type(e).__name__}: {str(e).splitlines()[0][:300]}\n"
                              f"  url {page.url}\n  evidence {st.evidence}/{prefix}-FAIL-step{i}.png and .aria.yml")
    return shots


def cmd_browser(args) -> int:
    st = State(args)
    st.require_stack()
    role = None if args.as_user == "anon" else args.as_user
    pw, browser, page, events = browser_session(st, role, getattr(args, "headed", False), getattr(args, "slow_mo", 0))
    result = {"as": args.as_user}
    try:
        if args.browser_cmd in ("snapshot", "screenshot"):
            page.goto(expand_path_ui(st, args.path), timeout=args.timeout * 1000)
            page.wait_for_load_state("networkidle", timeout=args.timeout * 1000)
            if args.wait_text:
                page.get_by_text(args.wait_text).first.wait_for(state="visible", timeout=args.timeout * 1000)
            name = args.save or f"{args.browser_cmd}-{stamp()}"
            result["url"] = page.url
            result["screenshot"] = save_shot(st, page, name, getattr(args, "full_page", False))
            if args.browser_cmd == "snapshot":
                snap = page.locator("body").aria_snapshot()
                (st.evidence / f"{name}.aria.yml").write_text(snap)
                print(snap)
        else:
            raw = sys.stdin.read() if args.steps in (None, "-") else Path(args.steps).read_text()
            steps = json.loads(raw)
            for s in steps:
                if isinstance(s.get("goto"), str):
                    s["goto"] = expand_path_ui(st, s["goto"])
            prefix = args.save or f"run-{stamp()}"
            result["screenshots"] = run_steps(st, page, steps, prefix, args.timeout)
            result["steps"] = len(steps)
            result["final_url"] = page.url
    finally:
        result.update(events)
        browser.close()
        pw.stop()
    for k in ("page_errors", "api_errors", "failed_requests", "console_errors"):
        if result[k]:
            log(f"WARNING {k}: {result[k][:10]}")
    if args.browser_cmd == "run":
        print(json.dumps(result, indent=2))
    noisy = result["page_errors"] or (args.strict and (result["api_errors"] or result["console_errors"]))
    return 1 if noisy else 0


def expand_path_ui(st: State, path: str) -> str:
