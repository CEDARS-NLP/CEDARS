def cmd_seed(args) -> int:
    st = State(args)
    st.require_stack()
    src = Path(st.data["images"]["src"])
    for role in ROLES:
        login(st, role)
    name = args.project_name or f"verify-{stamp()}"
    r = api_call(st, "admin", "POST", "/projects", json_body={
        "name": name, "description": "control-cedars seed (synthetic data only)",
        "llm_provider": "vllm", "llm_model": "fake-clinical", "llm_api_base": "http://fake-llm:8080"})
    if r.status_code != 201:
        raise CheckFailed(f"create project -> {r.status_code} {r.text[:300]}")
    pid = r.json()["id"]
    for role in ("annotator", "viewer"):
        r = api_call(st, "admin", "POST", f"/projects/{pid}/members", json_body={"email": user_email(role), "role": role})
        if r.status_code != 201:
            raise CheckFailed(f"add {role} member -> {r.status_code} {r.text[:300]}")
    seed = {"project_id": pid, "project_name": name, "users": {k: user_email(k) for k in ROLES},
            "password_hint": "state.json secrets.user_password", "llm": "vllm/fake-clinical @ http://fake-llm:8080"}
    if not args.no_upload:
        csv = src / SAMPLE_CSV
        if not csv.exists():  # refs before a2ae6891 (2026-09-22) predate the bundled sample; the data is the same
            csv = repo_root(args) / SAMPLE_CSV
            log(f"= {SAMPLE_CSV} not in the stack's ref; uploading the working tree's copy")
        r = api_call(st, "admin", "POST", f"/projects/{pid}/data/upload",
                     data={"column_mapping": json.dumps(SAMPLE_MAPPING)},
                     files={"file": (csv.name, csv.read_bytes(), "text/csv")})
        if r.status_code != 201:
            raise CheckFailed(f"upload sample -> {r.status_code} {r.text[:300]}")
        sid = r.json()["id"]
        seed["data_source_id"] = sid
        seed["s3_key"] = r.json()["config"].get("s3_key")
        if not args.no_ingest:
            r = api_call(st, "admin", "POST", f"/projects/{pid}/data/sources/{sid}/ingest")
            if r.status_code not in (200, 201, 202):
                raise CheckFailed(f"start ingestion -> {r.status_code} {r.text[:300]}")
            deadline = time.time() + args.timeout
            src_status = None
            while time.time() < deadline:
                src_status = api_call(st, "admin", "GET", f"/projects/{pid}/data/sources/{sid}").json()
                if src_status["status"] in ("completed", "failed"):
                    break
                time.sleep(2)
            if not src_status or src_status["status"] != "completed":
                raise CheckFailed(f"ingestion did not complete: {src_status}")
            # Count from the DB so a broken patient-list API (old releases) does not hide whether ingestion worked.
            proc = psql_ro(st, f"select count(*) from patients where project_id = '{pid}' and deleted_at is null", "-tA")
            total = int(proc.stdout.strip()) if proc.returncode == 0 else None
            seed.update({"row_count": src_status["row_count"], "patients": total})
            if (total, src_status["row_count"]) != (SAMPLE_PATIENTS, SAMPLE_NOTES):
                raise CheckFailed(f"expected {SAMPLE_PATIENTS} patients / {SAMPLE_NOTES} notes, got {total} / {src_status['row_count']}")
            r = api_call(st, "admin", "GET", f"/projects/{pid}/data/patients?limit=50")
            seed["patients_api"] = r.status_code
            if r.status_code != 200 or r.json().get("total") != total:
                msg = f"GET /data/patients -> {r.status_code} {r.text[:200]} (DB has {total} patients)"
                if not getattr(args, "tolerate_api_errors", False):
                    raise CheckFailed(msg + "; see `control-cedars stack logs backend --grep Traceback`")
                log(f"  WARN  {msg}")
    st.data["last_seed"] = seed
    st.save()
    emit(args, seed, f"seeded project {name} ({pid})\n  users {', '.join(seed['users'].values())}\n"
         + (f"  data source {seed.get('data_source_id')}: {seed.get('row_count', 'not ingested')} notes, {seed.get('patients', '-')} patients\n" if not args.no_upload else "")
         + "  {project} and {source} now expand in `api`, `ws` and `browser` paths")
    return 0


