    ${s.notes ? `<h4>Grade notes</h4>${s.notes}` : ""}
    <h4>How to prove it</h4>${s.driving || `<p class="empty">No "Driving it" bullet names this id.</p>`}
    <h4>Gotchas</h4>${g.map(x => `<div class="gotcha hit">${x.html}</div>`).join("")}
    ${gn.length ? `<div class="n">Cite the same source lines as this row's evidence:</div>` + gn.map(x => `<div class="gotcha near">${x.html}</div>`).join("") : ""}
    ${g.length + gn.length ? "" : `<p class="empty">None tied to this row.</p>`}
    <p><a class="link" data-area="${esc(s.file)}">All ${area.gotchas.length} ${esc(s.area)} gotchas</a></p>
    <h4>Journeys</h4>${js.length ? js.map(j => `<div><a class="link" data-j="${j.id}">${esc(j.name)}</a> ${badge(j.verdict)}</div>`).join("") : `<p class="empty">Not part of a journey.</p>`}`;
}
function panelArea(a) {
  return `<h3>${esc(a.title)}</h3><div class="n">${esc(a.file)} · last verified ${esc(a.last_verified)}</div>
    <div class="bar">${bar(a.subs)}</div>${a.intro}<h4>How to get to it</h4>${a.how}
    <h4>Gotchas (${a.gotchas.length})</h4>${a.gotchas.map(g => `<div class="gotcha">${g.html}</div>`).join("")}`;
}
function panelJourney(j) {
  return `<h3>${esc(j.name)}</h3><div>${badge(j.verdict)} <span class="n">${esc(j.id)} · ${esc(j.areas)} · last live ${esc(j.last)}</span></div><p>${j.result}</p>
    <h4>Touches (${j.ids.length})</h4><div>${j.ids.map(i => `<a class="link" data-id="${i}">${i}</a>`).join(", ")}</div>${j.html}`;
}
function panelHome() {
  const worst = subs.filter(s => s.maturity === "stub" || s.liveState === "failed");
  return `<h3>Start here</h3><p>Tiles are sub-features, colored by maturity. <b>Striped</b>: never driven live. <b>Red dot</b>: a live drive failed. Click an area title for its summary and gotchas, the Journeys tab for cross-area flows, Matrix for counts.</p>
    <h4>Stub or failed live (${worst.length})</h4>${worst.map(s => `<div><a class="link" data-id="${s.id}">${s.id}</a> ${badge(s.maturity)}</div>`).join("")}`;
}
function render() {
  chips($("fmat"), D.maturity, st.mat, m => MCOL[m]);
  chips($("flive"), LIVE, st.live);
  chips($("fsurf"), SURF, st.surf);
  $("tabs").innerHTML = [["map","Map"],["journeys","Journeys"],["matrix","Matrix"]].map(([k,l]) =>
    `<span class="tab ${st.tab === k ? "on" : ""}" data-tab="${k}">${l}</span>`).join("") +
    (st.journey ? `<span class="chip" id="clearj">✕ journey filter: ${esc(st.journey)}</span>` : "");
  $("view").innerHTML = st.tab === "map" ? viewMap() : st.tab === "journeys" ? viewJourneys() : viewMatrix();
  const p = st.panel || {};
  $("panel").innerHTML = p.sub ? panelSub(byId[p.sub]) : p.area ? panelArea(D.areas.find(a => a.file === p.area))
    : p.j ? panelJourney(D.journeys.find(j => j.id === p.j)) : panelHome();
}
document.addEventListener("click", ev => {
  const t = ev.target.closest("[data-id],[data-area],[data-j],[data-tab],[data-area-m],#clearj");
  if (!t) return;
  if (t.id === "clearj") { st.journey = null; }
  else if (t.dataset.tab) st.tab = t.dataset.tab;
  else if (t.dataset.id) { st.sel = t.dataset.id; st.panel = {sub: t.dataset.id}; }
  else if (t.dataset.area) st.panel = {area: t.dataset.area};
  else if (t.dataset.areaM) { const [f, m] = t.dataset.areaM.split("|"); st.mat = new Set([m]); st.tab = "map"; st.panel = {area: f}; }
  else if (t.dataset.j) { st.journey = st.journey === t.dataset.j && st.tab === "journeys" ? null : t.dataset.j; st.panel = {j: t.dataset.j};
    if (t.closest("#panel")) st.tab = "map"; }
  render();
});
$("q").oninput = ev => { st.q = ev.target.value.trim().toLowerCase(); render(); };
header(); render();
</script></body></html>
"""


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--out", default="/tmp/cedars-feature-map.html", help="output file (default: %(default)s)")
    ap.add_argument("--open", action="store_true", help="open the page in the default browser")
    args = ap.parse_args()
    data = build()
    out = Path(args.out).resolve()
    out.write_text(PAGE.replace("__DATA__", json.dumps(data).replace("</", "<\\/")))
    n = sum(len(a["subs"]) for a in data["areas"])
    print(f"wrote {out}: {n} sub-features, {len(data['areas'])} areas, {len(data['journeys'])} journeys")
    if args.open:
        webbrowser.open(out.as_uri())
    return 0


if __name__ == "__main__":
    sys.exit(main())
