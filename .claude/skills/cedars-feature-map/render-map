    return `<span class="${cls}" style="background-color:${MCOL[s.maturity]}" data-id="${s.id}" title="${esc(s.id)} · ${esc(s.maturity)} · ${esc(s.liveState)}\n${esc(s.what_text)}"></span>`;
  }).join("");
}
