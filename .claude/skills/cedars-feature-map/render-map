#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""render-map: turn features/*.md into one self-contained, interactive HTML page.

The markdown stays the source of truth; this only reads it. The page has no
external assets, so it opens offline and can be attached to a ticket.

  render-map                      write /tmp/cedars-feature-map.html
  render-map --open               ... and open it in the default browser
  render-map --out map.html       write somewhere else
"""
import argparse
import html
import json
import re
import sys
import webbrowser
from pathlib import Path

FEATURES = Path(__file__).resolve().parent / "features"
MATURITY = ["deferred", "stub", "api-only", "beta", "beta (stable pending live)", "stable"]


def inline(s: str) -> str:
    """Markdown inline (code, bold, links) to HTML; everything else escaped."""
    parts = re.split(r"(`[^`]*`)", s)
    out = []
    for p in parts:
        if p.startswith("`") and p.endswith("`") and len(p) > 1:
            out.append(f"<code>{html.escape(p[1:-1])}</code>")
        else:
            p = html.escape(p, quote=False)
            p = re.sub(r"\*\*(.+?)\*\*", r"<b>\1</b>", p)
            p = re.sub(r"\[([^\]]+)\]\([^)]+\)", r"\1", p)
            out.append(p)
    return "".join(out)


def block(md: str) -> str:
    """Just enough block markdown for these files: paragraphs, nested lists, code fences, tables."""
    out, para, lists, in_code, code = [], [], [], False, []

    def flush_para():
        if para:
            out.append(f"<p>{inline(' '.join(para))}</p>")
            para.clear()

    def close_lists(depth=0):
        while len(lists) > depth:
            out.append(f"</li></{lists.pop()}>")

    for line in md.splitlines():
        if line.strip().startswith("```"):
            if in_code:
                out.append(f"<pre>{html.escape(chr(10).join(code))}</pre>")
                code, in_code = [], False
            else:
                flush_para()
                close_lists()
                in_code = True
            continue
        if in_code:
            code.append(line)
            continue
        m = re.match(r"^(\s*)([-*]|\d+\.) (.*)$", line)
        if m:
            flush_para()
            depth = len(m.group(1)) // 2 + 1
            tag = "ol" if m.group(2)[0].isdigit() else "ul"
            if depth > len(lists):
                while depth > len(lists):
                    out.append(f"<{tag}><li>")
                    lists.append(tag)
            else:
                close_lists(depth)
                out.append("</li><li>")
            out.append(inline(m.group(3)))
        elif line.startswith("|"):
            flush_para()
            close_lists()
            cells = [c.strip() for c in line.strip().strip("|").split(" | ")]
            if all(re.fullmatch(r":?-+:?", c) for c in cells):
                continue
            out.append("<div class='trow'>" + "".join(f"<span>{inline(c)}</span>" for c in cells) + "</div>")
        elif not line.strip():
            flush_para()
            close_lists()
        elif lists:
            out.append(" " + inline(line.strip()))
        else:
            para.append(line.strip())
    flush_para()
    close_lists()
    return "".join(out)


def section(text: str, heading: str) -> str:
    m = re.search(rf"^## {re.escape(heading)}[^\n]*\n(.*?)(?=^## |\Z)", text, re.M | re.S)
    return m.group(1).strip() if m else ""


def bullets(md: str) -> list[str]:
    """Top-level `- ` bullets with their continuation and nested lines."""
    items, cur = [], None
    for line in md.splitlines():
        if line.startswith("- "):
            if cur is not None:
                items.append("\n".join(cur))
            cur = [line]
        elif cur is not None:
            cur.append(line)
    if cur is not None:
        items.append("\n".join(cur))
    return items


def cites(md: str) -> list[tuple[str, int, int]]:
    """`dir/name.py:12-30` → ("name.py", 12, 30). Bare `:47` continuations are skipped."""
    return [(m[0], int(m[1]), int(m[2] or m[1]))
            for m in re.findall(r"([A-Za-z_][\w.-]*\.(?:py|tsx?|tf|ya?ml|conf|md)):(\d+)(?:-(\d+))?", md)]


def near(a: list, b: list, slack: int = 10) -> bool:
    return any(fa == fb and la - slack <= hb and lb - slack <= ha for fa, la, ha in a for fb, lb, hb in b)


def parse_area(f: Path) -> dict:
    t = f.read_text()
    title = t.splitlines()[0].lstrip("# ").strip()
    lv = re.search(r"^Last verified: (.*)$", t, re.M)
    intro = t.split("## Sub-features")[0]
    intro = re.sub(r"^#.*\n|^Last verified:.*\n", "", intro, flags=re.M).strip()
    subs = []
    for rid, rest in re.findall(r"^\| ([a-z][a-z0-9-]+) \| (.*)$", section(t, "Sub-features"), re.M):
        cells = [c.strip() for c in rest.rstrip().rstrip("|").split(" | ")]
        if len(cells) != 6:
            sys.exit(f"{f.name}: row {rid} has {len(cells)} cells, expected 6")
        what, mat, surface, since, live, evidence = cells
        subs.append({"id": rid, "what": inline(what), "what_text": re.sub(r"[`*]", "", what), "maturity": mat,
                     "surface": surface, "since": since, "live": inline(live), "live_text": live,
                     "evidence": inline(evidence)})
    known = {s["id"] for s in subs}

    def named(md: str) -> set[str]:
        return {i for i in known if re.search(rf"(?<![a-z0-9-]){re.escape(i)}(?![a-z0-9-])", md)}

    driving = {}
    for b in bullets(section(t, "Driving it with control-cedars")):
        # "**a**, **b** and **c**:", "**a / b**:", or "This also drives **c**" all count
        bold = " ".join(re.findall(r"\*\*([^*]+)\*\*", b))
        for rid in named(bold):
            driving.setdefault(rid, []).append(block(b))
    notes = {}
    for b in bullets(section(t, "Sub-features")):  # grade notes under the table
        for rid in named(b):
            notes.setdefault(rid, []).append(block(b))
    evidence = {s["id"]: cites(s["evidence"]) for s in subs}
    gotchas = []
    for b in bullets(section(t, "Gotchas")):
        m = re.match(r"- \*\*(.+?)\*\*", b)
        c = cites(b)
        gotchas.append({"title": inline(m.group(1)) if m else "", "html": block(b), "ids": sorted(named(b)),
                        "near": sorted(i for i, e in evidence.items() if near(e, c))})
    for s in subs:
        s["driving"] = "".join(driving.get(s["id"], []))
        s["notes"] = "".join(notes.get(s["id"], []))
    return {"file": f.name, "title": title, "last_verified": lv.group(1) if lv else "", "intro": block(intro),
            "subs": subs, "gotchas": gotchas, "how": block(section(t, "How to get to it (user POV)"))}


def parse_readme() -> dict:
    t = (FEATURES / "README.md").read_text()
    index = {}
    for f, area, roles, overall in re.findall(r"^\| \[([^\]]+)\]\([^)]+\) \| ([^|]+) \| ([^|]+) \| ([^|]+) \|$", t, re.M):
        index[f] = {"scope": area.strip(), "roles": roles.strip(), "overall": overall.strip()}
    order = [m.strip() for m in re.findall(r"^\d+\. ([a-z-]+)$", section(t, "Sweep order"), re.M)]
    snap = re.search(r"^Snapshot \(.*?\):\n((?:- .*\n)+)", t, re.M)
    return {"index": index, "order": order, "snapshot": block(snap.group(0)) if snap else ""}


def parse_journeys(all_ids: set[str]) -> list[dict]:
    t = (FEATURES / "multi-surface-journeys.md").read_text()
    out = []
    for jid, name, areas, last, result in re.findall(r"^\| (j-[a-z-]+) \| ([^|]+) \| ([^|]+) \| ([^|]+) \| ([^|]+) \|$", t, re.M):
        body = section(t, jid)
        touches = re.search(r"^Touches[^\n]*\n?", body, re.M)
        ids = set()
        if touches:
            line = touches.group(0)
            ids = {i for i in re.findall(r"`([a-z][a-z0-9-]+)`", line) if i in all_ids}
            for pat in re.findall(r"`\*(-[a-z-]+)`", line):
                ids |= {i for i in all_ids if i.endswith(pat)}
        r = result.strip()
        verdict = next((v for v in ("PARTIAL", "FAIL", "PASS", "SKIP") if r.startswith(v)), "NOT DRIVEN")
        out.append({"id": jid, "name": name.strip(), "areas": areas.strip(), "last": last.strip(),
                    "result": inline(r), "verdict": verdict, "ids": sorted(ids),
                    "html": block(body.replace(touches.group(0), "") if touches else body)})
    return out


def build() -> dict:
    readme = parse_readme()
    files = {p.stem: p for p in FEATURES.glob("*.md") if p.name not in ("README.md", "multi-surface-journeys.md")}
    order = [a for a in readme["order"] if a in files] + sorted(set(files) - set(readme["order"]))
    areas = []
    for stem in order:
        a = parse_area(files[stem])
        a.update(readme["index"].get(a["file"], {}))
        areas.append(a)
    ids = {s["id"] for a in areas for s in a["subs"]}
    return {"areas": areas, "journeys": parse_journeys(ids), "snapshot": readme["snapshot"], "maturity": MATURITY}


