<script>
const D = __DATA__;
const MCOL = {"deferred":"var(--deferred)","stub":"var(--stub)","api-only":"var(--api-only)","beta":"var(--beta)","beta (stable pending live)":"var(--pending)","stable":"var(--stable)"};
const VCOL = {"PASS":"var(--pass)","FAIL":"var(--fail)","PARTIAL":"var(--partial)","SKIP":"var(--skip)","NOT DRIVEN":"var(--skip)"};
const LIVE = ["driven","failed","not driven"], SURF = ["UI","API","WS","infra"];
const subs = D.areas.flatMap(a => a.subs.map(s => Object.assign(s, {area: a.title, file: a.file,
  liveState: /FAIL/.test(s.live_text) ? "failed" : /^\d{4}-/.test(s.live_text) ? "driven" : "not driven",
  surf: /UI/.test(s.surface) ? "UI" : /^API/.test(s.surface) ? "API" : /WS/.test(s.surface) ? "WS" : "infra",
  hay: [s.id, s.what_text, s.surface, s.live_text, s.evidence, a.title, s.notes].join(" ").toLowerCase()})));
const byId = Object.fromEntries(subs.map(s => [s.id, s]));
const st = {q:"", mat:new Set(D.maturity), live:new Set(LIVE), surf:new Set(SURF), tab:"map", journey:null, sel:null};
const $ = id => document.getElementById(id);
const esc = s => s.replace(/[&<>"]/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const ok = s => st.mat.has(s.maturity) && st.live.has(s.liveState) && st.surf.has(s.surf) && (!st.q || s.hay.includes(st.q));
const badge = m => `<span class="badge" style="background:${MCOL[m]||VCOL[m]}">${esc(m)}</span>`;
const count = (list, key, val) => list.filter(x => x[key] === val).length;

function bar(list) {
  return D.maturity.map(m => { const n = count(list, "maturity", m);
    return n ? `<span title="${m}: ${n}" style="width:${100*n/list.length}%;background:${MCOL[m]}"></span>` : ""; }).join("");
}
function chips(el, values, set, color) {
  el.innerHTML = el.querySelector("b").outerHTML + values.map(v => {
    const n = v in MCOL ? count(subs, "maturity", v) : count(subs, el.id === "flive" ? "liveState" : "surf", v);
    return `<span class="chip ${set.has(v) ? "" : "off"}" data-v="${esc(v)}">${color ? `<i style="background:${color(v)}"></i>` : ""}${esc(v)} ${n}</span>`;
  }).join("");
  el.querySelectorAll(".chip").forEach(c => c.onclick = ev => {
    const v = c.dataset.v;
    if (ev.altKey || ev.metaKey) { set.clear(); set.add(v); } else if (set.has(v)) set.delete(v); else set.add(v);
    render();
  });
}
function header() {
  const lv = [...new Set(D.areas.map(a => a.last_verified.split(" (")[0]))].join(", ");
  $("hdr").innerHTML = `${subs.length} sub-features in ${D.areas.length} areas, ${D.journeys.length} journeys. Last verified ${esc(lv)}. Click a tile for details; ⌥/⌘-click a chip to show only that value.` + D.snapshot;
  $("totalbar").innerHTML = bar(subs);
}
function tiles(a) {
  const hit = st.journey ? new Set(D.journeys.find(j => j.id === st.journey).ids) : null;
  return a.subs.map(s => {
    const cls = ["tile", s.liveState === "not driven" ? "notdriven" : "", s.liveState === "failed" ? "failed" : "",
