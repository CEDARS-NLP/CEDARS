# Copy this file to cedars/.env only when running the Python application
# directly from cedars/. Docker Compose uses the root .env.sample instead.
SECRET_KEY=change-this-to-a-long-random-value
ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost
COOKIE_SECURE=true

DB_PROTOCOL=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_HOST_PORT=5432
DB_USER=cedars
DB_PWD=change-this-postgres-password
DB_ADMIN_NAME=postgres
GLOBAL_DB_NAME=cedars_global
DB_PARAMS=

REDIS_PROTOCOL=redis
REDIS_URL=localhost
REDIS_PORT=6379
AUTH_TOKEN=

MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-this-minio-password
S3_ENDPOINT_URL=http://localhost:9000

PINES_API_URL=http://localhost:8036
RQ_DASHBOARD_URL=/rq
CHUNK_SIZE_INSERT_NOTES=1000
CHUNK_SIZE_UPSERT_PATIENTS=2000