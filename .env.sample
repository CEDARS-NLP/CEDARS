# Database backend: mongodb or sqlite
DB_TYPE=mongodb
 
# MongoDB (local docker) - required if DB_TYPE=mongodb
DB_HOST=db
DB_NAME=cedars
DB_PORT=27017
DB_HOST_PORT=27018
DB_USER=admin
DB_PWD=password
 
# SQLite - required if DB_TYPE=sqlite
# SQLITE_DB_PATH=cedars.db
 
# AWS DocDB (alternative to local)
# DB_HOST=xxx.cluster-yyyy.us-east-1.docdb.amazonaws.com
# DB_NAME=cedars
# DB_PORT=27017
# DB_USER=admin
# DB_PWD=password
# DB_PARAMS="tls=true&tlsCAFile=global-bundle.pem&replicaSet=rs0&readPreference=secondaryPreferred&retryWrites=false"
 
# Redis
REDIS_URL=redis
REDIS_PORT=6379
 
# MinIO (object storage)
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=rootuser
MINIO_SECRET_KEY=rootpassword
MINIO_VERSION=RELEASE.2024-05-10T01-41-38Z
 
# PINES NLP Service
PINES_API_URL=http://pines:8036
 
# LLM Providers (optional - for LLM-based classification)
# Set the API keys for providers you want to use
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...
 
# Local LLM servers (Ollama, LMStudio)
# OLLAMA_API_BASE=http://localhost:11434
# LMSTUDIO_API_BASE=http://localhost:1234
 
# AWS Bedrock (uses AWS credentials from environment)
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1
AWS_REGION_NAME=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0:48k
AWS_BEDROCK_ROLE_ARN=arn:aws:iam::180294205688:role/userServiceRoleBedrockBatchInference
AWS_BEDROCK_S3_BUCKET=llm-vte-labeling-data
# Flask App
SECRET_KEY=change-me-in-production
RQ_DASHBOARD_URL=/rq
ENV=dev
 
# Worker scaling
WORKER_SCALE=2
GPU_SCALE=1
PINES_WORKERS=1
 
# Prometheus (for tests)
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus-multiproc
SESSION_TYPE=redis