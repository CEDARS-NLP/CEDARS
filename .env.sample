SECRET_KEY=change-this-to-a-long-random-value
ENV=production
CORS_ORIGINS=http://localhost
COOKIE_SECURE=false

# PostgreSQL is shared by all projects. The application creates one database
# per project plus the global account/project-registry database below.
DB_PROTOCOL=postgresql
DB_HOST=postgres
DB_PORT=5432
DB_HOST_PORT=5432
DB_USER=cedars
DB_PWD=change-this-postgres-password
DB_ADMIN_NAME=postgres
GLOBAL_DB_NAME=cedars_global
DB_PARAMS=

REDIS_PROTOCOL=redis
REDIS_URL=redis
REDIS_PORT=6379
AUTH_TOKEN=

MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-this-minio-password
MINIO_VERSION=RELEASE.2024-05-10T01-41-38Z
S3_ENDPOINT_URL=http://minio:9000

PINES_API_URL=http://pines:8036
PINES_WORKERS=1
WORKER_SCALE=2
GPU_SCALE=1
CHUNK_SIZE_INSERT_NOTES=1000
CHUNK_SIZE_UPSERT_PATIENTS=2000
